{
  "description": "Atlas prüft jede von Claude bearbeitete Pascal-Datei mit den Prüfregeln des Projekts (MCP-Werkzeug hook_check) und gibt Warnungen und Fehler sofort an Claude zurück. Abschalten: \"mcp\": {\"disabledTools\": [\"hook_check\"]} in atlas.json.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Edit(**/*.pas)",
            "server": "plugin:atlas:delphi",
            "tool": "hook_check",
            "input": { "file": "${tool_input.file_path}" },
            "timeout": 60
          },
          {
            "type": "mcp_tool",
            "if": "Edit(**/*.dpr)",
            "server": "plugin:atlas:delphi",
            "tool": "hook_check",
            "input": { "file": "${tool_input.file_path}" },
            "timeout": 60
          },
          {
            "type": "mcp_tool",
            "if": "Edit(**/*.dpk)",
            "server": "plugin:atlas:delphi",
            "tool": "hook_check",
            "input": { "file": "${tool_input.file_path}" },
            "timeout": 60
          },
          {
            "type": "mcp_tool",
            "if": "Edit(**/*.inc)",
            "server": "plugin:atlas:delphi",
            "tool": "hook_check",
            "input": { "file": "${tool_input.file_path}" },
            "timeout": 60
          }
        ]
      }
    ]
  }
}
