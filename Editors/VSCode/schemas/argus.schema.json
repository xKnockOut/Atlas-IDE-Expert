{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Argus-Konfiguration",
  "description": "Einstellungen für Argus im Projektordner.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "delphiVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Delphi-Version wie in der Registry, z. B. \"37.0\" für Delphi 13 oder \"23.0\" für Delphi 12. Leer: neueste installierte Version.",
      "examples": [
        "37.0",
        "23.0"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de",
      "description": "Sprache der Meldungen."
    },
    "project": {
      "type": "string",
      "description": "Projektdatei (.dproj) relativ zu diesem Ordner. Leer: automatisch suchen."
    },
    "config": {
      "type": "string",
      "description": "Build-Konfiguration, z. B. Debug oder Release.",
      "examples": [
        "Debug",
        "Release"
      ]
    },
    "platform": {
      "type": "string",
      "description": "Zielplattform.",
      "examples": [
        "Win32",
        "Win64"
      ]
    },
    "rules": {
      "type": "object",
      "description": "Prüfregeln einzeln einstellen: Regel-ID → Schweregrad oder Objekt mit \"severity\" und Optionen.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "off",
              "hint",
              "info",
              "information",
              "warning",
              "error"
            ]
          },
          {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "off",
                  "hint",
                  "info",
                  "information",
                  "warning",
                  "error"
                ]
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ausnahmen dieser Regel: Glob-Muster für Pfade (relativ zur Konfiguration) oder Unit-Namen."
              }
            }
          }
        ]
      }
    },
    "compiler": {
      "type": "object",
      "description": "Compiler-Anbindung (dcc32/dcc64).",
      "additionalProperties": false,
      "properties": {
        "onSave": {
          "type": "boolean",
          "default": true,
          "description": "Nach dem Speichern einer Quelldatei das Projekt im Hintergrund kompilieren und die Meldungen anzeigen."
        }
      }
    },
    "inlayHints": {
      "type": "object",
      "description": "Inlay Hints im Editor.",
      "additionalProperties": false,
      "properties": {
        "parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Parameternamen vor den Argumenten eines Aufrufs."
        },
        "inferredTypes": {
          "type": "boolean",
          "default": true,
          "description": "Abgeleiteter Typ hinter var X := …."
        },
        "endMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Hinter dem end langer Blöcke anzeigen, was dort endet."
        },
        "endMarkerMinLines": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Mindestlänge eines Blocks in Zeilen für eine Endmarkierung."
        }
      }
    },
    "minConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Regeltreffer unter dieser Konfidenz ausblenden."
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordner und Dateien, die nicht geprüft werden (Glob-Muster relativ zu diesem Ordner: *, **, ?).",
      "examples": [
        [
          "ThirdParty/**",
          "Generated/*.pas"
        ]
      ]
    },
    "format": {
      "type": "object",
      "description": "Formatierung (Dokument und Auswahl formatieren). Gesetzte Werte haben Vorrang vor .editorconfig.",
      "additionalProperties": false,
      "properties": {
        "indentSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 2,
          "description": "Breite einer Einrückungsebene."
        },
        "useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Mit Tabs statt Leerzeichen einrücken."
        },
        "keywordCase": {
          "type": "string",
          "enum": ["preserve", "lower", "upper"],
          "default": "preserve",
          "description": "Schreibweise reservierter Wörter."
        },
        "trimTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Leerzeichen am Zeilenende entfernen."
        },
        "insertFinalNewline": {
          "type": "boolean",
          "default": false,
          "description": "Datei mit einem Zeilenende abschließen."
        },
        "spaceAroundAssignment": {
          "type": "boolean",
          "default": true,
          "description": "Genau ein Leerzeichen vor und nach :=."
        },
        "spaceAfterComma": {
          "type": "boolean",
          "default": true,
          "description": "Genau ein Leerzeichen nach Kommas."
        },
        "endOfLine": {
          "type": "string",
          "enum": ["lf", "crlf"],
          "description": "Zeilenenden vereinheitlichen; ohne Angabe bleiben sie."
        }
      }
    }
  },
  "additionalProperties": false
}
