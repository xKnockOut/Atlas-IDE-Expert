{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BetterDelphiLSP-Konfiguration",
  "description": "Einstellungen für BetterDelphiLSP im Projektordner.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "delphiVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Delphi-Version als Produktnummer (\"13\", \"12\", \"10.4\") oder wie in der Registry (\"37.0\" für Delphi 13, \"23.0\" für Delphi 12). Leer: neueste installierte Version.",
      "examples": [
        "37.0",
        "23.0"
      ],
      "x-page": "Allgemein",
      "x-control": "Auswahl aus den installierten Versionen",
      "x-issue": "#47, #258"
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de",
      "description": "Sprache der Meldungen.",
      "x-page": "Allgemein",
      "x-control": "Auswahl",
      "x-issue": "#24"
    },
    "project": {
      "type": "string",
      "description": "Projektdatei (.dproj) relativ zu diesem Ordner. Leer: automatisch suchen.",
      "x-page": "Projekt",
      "x-control": "Vorgabe: aktives IDE-Projekt",
      "x-issue": "#14, #24"
    },
    "config": {
      "type": "string",
      "description": "Build-Konfiguration, z. B. Debug oder Release.",
      "examples": [
        "Debug",
        "Release"
      ],
      "x-page": "Projekt",
      "x-control": "Auswahl aus der .dproj",
      "x-issue": "#14, #46"
    },
    "platform": {
      "type": "string",
      "description": "Zielplattform.",
      "examples": [
        "Win32",
        "Win64"
      ],
      "x-page": "Projekt",
      "x-control": "Auswahl aus der .dproj",
      "x-issue": "#14, #46"
    },
    "rules": {
      "type": "object",
      "description": "Prüfregeln einzeln einstellen: Regel-ID → Schweregrad oder Objekt mit \"severity\" und Optionen.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "off",
              "hint",
              "info",
              "information",
              "warning",
              "error"
            ]
          },
          {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "off",
                  "hint",
                  "info",
                  "information",
                  "warning",
                  "error"
                ]
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ausnahmen dieser Regel: Glob-Muster für Pfade (relativ zur Konfiguration) oder Unit-Namen."
              },
              "layers": {
                "type": "array",
                "description": "Nur forbidden-uses: Schichtregeln für uses-Beziehungen.",
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "deny"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "description": "Glob auf den Unit-Namen (z. B. \"*.Common.*\") oder mit \"/\" auf den Pfad (z. B. \"Source/Common/**\")."
                    },
                    "deny": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Verbotene Units als Globs, z. B. \"Vcl.*\"."
                    },
                    "allow": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ausnahmen von deny."
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "x-page": "Prüfregeln",
      "x-control": "Tabelle aus dem Regelkatalog",
      "x-issue": "#41"
    },
    "profile": {
      "description": "Regelprofil: standard, fast (nur Bugs und Schwachstellen), strict (experimentelle Regeln an, minConfidence low), security, style oder ein eigenes aus \"profiles\". Als Objekt getrennt für Editor und Kommandozeile.",
      "default": "standard",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "string",
              "description": "Profil im Editor."
            },
            "cli": {
              "type": "string",
              "description": "Profil der Kommandozeile (--check), z. B. strict im CI."
            }
          }
        }
      ],
      "examples": [
        "fast",
        "strict"
      ],
      "x-page": "Prüfregeln",
      "x-control": "Auswahl",
      "x-issue": "#146"
    },
    "profiles": {
      "type": "object",
      "description": "Eigene Regelprofile: Name → { \"extends\": eingebautes oder eigenes Profil, \"categories\": nur diese Kategorien, \"rules\": Regel-ID → Schweregrad }.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "bug",
                "vulnerability",
                "code-smell",
                "security-hotspot"
              ]
            }
          },
          "rules": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "information",
                "warning",
                "error"
              ]
            }
          }
        }
      },
      "x-page": "Prüfregeln",
      "x-control": "Profil-Editor",
      "x-issue": "#146"
    },
    "overrides": {
      "type": "array",
      "description": "Pfadregeln: Schweregrade für Dateien, die eines der Glob-Muster treffen, z. B. Tests oder generierten Code herabstufen. Regel-ID \"*\" steht für alle Regeln; spätere Einträge haben Vorrang.",
      "items": {
        "type": "object",
        "required": [
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "information",
                "warning",
                "error"
              ]
            }
          }
        }
      },
      "x-page": "Prüfregeln",
      "x-control": "Liste mit Mustern",
      "x-issue": "#146"
    },
    "excludeTests": {
      "type": "boolean",
      "default": false,
      "description": "Test-Units und Testprojekte (uses DUnitX.TestFramework, TestFramework oder TestInsight.*) nicht prüfen.",
      "x-page": "Prüfregeln",
      "x-control": "Kontrollkästchen",
      "x-issue": "#146"
    },
    "testProfile": {
      "type": "string",
      "description": "Regelprofil für Test-Units und Testprojekte; leer: wie \"profile\".",
      "examples": [
        "fast"
      ],
      "x-page": "Prüfregeln",
      "x-control": "Auswahl",
      "x-issue": "#146"
    },
    "compiler": {
      "type": "object",
      "description": "Compiler-Anbindung (dcc32/dcc64).",
      "additionalProperties": false,
      "properties": {
        "onSave": {
          "type": "boolean",
          "default": true,
          "description": "Nach dem Speichern einer Quelldatei das Projekt im Hintergrund kompilieren und die Meldungen anzeigen."
        },
        "backend": {
          "type": "string",
          "enum": [
            "auto",
            "dcc",
            "ide",
            "off"
          ],
          "default": "auto",
          "description": "Weg zum Compiler: auto wählt nach der erkannten Edition (dcc mit Kommandozeilen-Compiler, sonst ide über cc.ps1, sonst off), dcc ruft dcc32/dcc64 auf, ide übersetzt in einer eigenen Scratch-IDE (nur per Befehl, nicht beim Speichern), off schaltet ab."
        },
        "ideCommand": {
          "type": "string",
          "default": "",
          "description": "Pfad zu cc.ps1 für das Backend ide (RAD Studio Starter ohne Kommandozeilen-Compiler)."
        }
      },
      "x-page": "Compiler",
      "x-control": "Kontrollkästchen",
      "x-issue": "#40"
    },
    "completion": {
      "type": "object",
      "description": "Code-Vervollständigung.",
      "additionalProperties": false,
      "properties": {
        "matching": {
          "type": "string",
          "enum": [
            "fuzzy",
            "prefix"
          ],
          "default": "fuzzy",
          "description": "Auswahl der Vorschläge: unscharf (Teilfolgen, Kürzel wie TSL für TStringList) oder nur nach Präfix, falls ein Editor nachträglich strikt filtert."
        }
      },
      "x-page": "Vervollständigung",
      "x-control": "Auswahl",
      "x-issue": "#229"
    },
    "completeBlocks": {
      "type": "object",
      "description": "Blockabschluss beim Tippen: nach Enter hinter dem Schlüsselwort den passenden Abschluss ergänzen, wenn der Block noch offen ist.",
      "additionalProperties": false,
      "properties": {
        "begin": {
          "type": "boolean",
          "default": true,
          "description": "begin → end;"
        },
        "try": {
          "type": "boolean",
          "default": true,
          "description": "try → finally und end;"
        },
        "case": {
          "type": "boolean",
          "default": true,
          "description": "case … of → end;"
        },
        "record": {
          "type": "boolean",
          "default": true,
          "description": "record → end;"
        },
        "class": {
          "type": "boolean",
          "default": true,
          "description": "class, interface und object → end;"
        },
        "repeat": {
          "type": "boolean",
          "default": true,
          "description": "repeat → until ;"
        }
      },
      "x-page": "Eingabehilfen",
      "x-control": "Kontrollkästchen je Block",
      "x-issue": "#179"
    },
    "usesCommand": {
      "type": "boolean",
      "default": true,
      "description": "Eine Zeile \"/uses Unit1, Unit2\" wird nach Enter gelöscht und die Units kommen ins passende uses.",
      "x-page": "Eingabehilfen",
      "x-control": "Kontrollkästchen",
      "x-issue": "#254"
    },
    "sortUses": {
      "type": [
        "boolean",
        "string"
      ],
      "enum": [
        true,
        false,
        "alphabetic",
        "namespace"
      ],
      "default": false,
      "description": "\"uses aufräumen\" (source.organizeImports, z. B. beim Speichern) sortiert die uses: true oder \"alphabetic\" alphabetisch, \"namespace\" nach Namespace gruppiert (System, Vcl, ... und Units ohne Namespace zuletzt). Achtung: Die Reihenfolge bestimmt die Initialisierung der Units.",
      "x-page": "Eingabehilfen",
      "x-control": "Auswahl",
      "x-issue": "#182, #284"
    },
    "usesKeep": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Units, die \"ungenutzte uses entfernen\" nie entfernt, zusätzlich zu allen Units mit initialization-Abschnitt.",
      "x-page": "Eingabehilfen",
      "x-control": "Liste",
      "x-issue": "#284"
    },
    "memoryBudgetMb": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Obergrenze für den Symbolindex in MB. Darüber werden zuerst Bibliotheks-Units (RTL, VCL), dann Projekt-Units kompakt gehalten (nur interface-Symbole). 0: unbegrenzt.",
      "x-page": "Speicher",
      "x-control": "Zahlenfeld (MB)",
      "x-issue": "#185"
    },
    "requestTimeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "default": 10000,
      "description": "Zeitlimit für Anfragen in Millisekunden. Länger laufende Anfragen werden abgebrochen und im Log gemeldet.",
      "x-page": "Robustheit",
      "x-control": "Zahlenfeld (ms)",
      "x-issue": "#283"
    },
    "highlight": {
      "type": "object",
      "description": "Zusammengehörige Schlüsselwörter hervorheben, wenn der Cursor auf einem steht.",
      "additionalProperties": false,
      "properties": {
        "blockPairs": {
          "type": "boolean",
          "default": true,
          "description": "Blockpaare (begin/end, try/finally/except/end, case/of/end, repeat/until, if/then/else, Typen) und Routinen hervorheben."
        },
        "directives": {
          "type": "boolean",
          "default": true,
          "description": "Zusammengehörige {$IF…}/{$ELSE}/{$ENDIF} sowie {$REGION}/{$ENDREGION} hervorheben."
        },
        "exitPoints": {
          "type": "boolean",
          "default": true,
          "description": "Ausstiegspunkte der Routine sowie Kopf und Ende der Schleife bei Break/Continue hervorheben."
        },
        "exitKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Exit",
            "raise",
            "Abort",
            "Halt"
          ],
          "description": "Was als Ausstiegspunkt gilt; eigene Routinen, die immer eine Exception auslösen, lassen sich ergänzen."
        }
      },
      "x-page": "Editor",
      "x-control": "Kontrollkästchen, Liste",
      "x-issue": "#307"
    },
    "inlayHints": {
      "type": "object",
      "description": "Inlay Hints im Editor.",
      "additionalProperties": false,
      "properties": {
        "parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Parameternamen vor den Argumenten eines Aufrufs."
        },
        "inferredTypes": {
          "type": "boolean",
          "default": true,
          "description": "Abgeleiteter Typ hinter var X := …."
        },
        "endMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Hinter dem end langer Blöcke anzeigen, was dort endet."
        },
        "endMarkerMinLines": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Mindestlänge eines Blocks in Zeilen für eine Endmarkierung."
        }
      },
      "x-page": "Editor",
      "x-control": "Kontrollkästchen, Zahlenfeld",
      "x-issue": "#35"
    },
    "minConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Regeltreffer unter dieser Konfidenz ausblenden.",
      "x-page": "Prüfregeln",
      "x-control": "Auswahl",
      "x-issue": "#144"
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordner und Dateien, die nicht geprüft werden (Glob-Muster relativ zu diesem Ordner: *, **, ?).",
      "examples": [
        [
          "ThirdParty/**",
          "Generated/*.pas"
        ]
      ],
      "x-page": "Projekt",
      "x-control": "Liste mit Hinzufügen/Entfernen",
      "x-issue": "#24"
    },
    "format": {
      "type": "object",
      "description": "Formatierung (Dokument und Auswahl formatieren). Gesetzte Werte haben Vorrang vor .editorconfig.",
      "additionalProperties": false,
      "properties": {
        "indentSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 2,
          "description": "Breite einer Einrückungsebene."
        },
        "useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Mit Tabs statt Leerzeichen einrücken."
        },
        "keywordCase": {
          "type": "string",
          "enum": [
            "preserve",
            "lower",
            "upper"
          ],
          "default": "preserve",
          "description": "Schreibweise reservierter Wörter."
        },
        "trimTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Leerzeichen am Zeilenende entfernen."
        },
        "insertFinalNewline": {
          "type": "boolean",
          "default": false,
          "description": "Datei mit einem Zeilenende abschließen."
        },
        "spaceAroundAssignment": {
          "type": "boolean",
          "default": true,
          "description": "Genau ein Leerzeichen vor und nach :=."
        },
        "spaceAfterComma": {
          "type": "boolean",
          "default": true,
          "description": "Genau ein Leerzeichen nach Kommas."
        },
        "endOfLine": {
          "type": "string",
          "enum": [
            "lf",
            "crlf"
          ],
          "description": "Zeilenenden vereinheitlichen; ohne Angabe bleiben sie."
        }
      },
      "x-page": "Formatierung",
      "x-control": "Zahlenfeld, Kontrollkästchen, Auswahl",
      "x-issue": "#43"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ],
      "default": "info",
      "description": "Mindeststufe der Meldungen im Ausgabefenster und in der Logdatei. Gilt ab dem nächsten Start; die Kommandozeilenoption --log-level hat Vorrang.",
      "x-page": "Protokoll",
      "x-control": "Auswahl",
      "x-issue": "#76, #96",
      "x-commandLine": "--log-level",
      "x-restart": true
    },
    "logFile": {
      "type": "string",
      "default": "",
      "description": "Optionale Logdatei des Servers (Rotation bei 10 MB). Gilt ab dem nächsten Start; --log hat Vorrang.",
      "x-page": "Protokoll",
      "x-control": "Datei wählen",
      "x-issue": "#76, #96",
      "x-commandLine": "--log",
      "x-restart": true
    },
    "traceFile": {
      "type": "string",
      "default": "",
      "description": "Optionaler Mitschnitt aller JSON-Nachrichten zur Fehlersuche. Gilt ab dem nächsten Start; --trace hat Vorrang.",
      "x-page": "Protokoll",
      "x-control": "Datei wählen",
      "x-issue": "#76, #96",
      "x-commandLine": "--trace",
      "x-restart": true
    }
  },
  "additionalProperties": false
}
