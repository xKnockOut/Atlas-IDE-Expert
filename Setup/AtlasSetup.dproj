        <DCCReference Include="..\Packages\Atlas.Text\Source\Checkin\Atlas.Text.Checkin.pas"/>
        <DCCReference Include="..\Packages\Atlas.IDE.Expert\Source\Core\Style\Atlas.Core.Style.Color.pas"/>
