<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{3C6E2F0A-6B2D-4F0E-9E0B-5A1D7C2B8E41}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Packages\BDLsp.Common\BDLsp.Common.dproj">
            <Dependencies></Dependencies>
        </Projects>
        <Projects Include="Packages\BDLsp.Windows\BDLsp.Windows.dproj">
            <Dependencies>Packages\BDLsp.Common\BDLsp.Common.dproj</Dependencies>
        </Projects>
        <Projects Include="Application\BetterDelphiLSP.dproj">
            <Dependencies>Packages\BDLsp.Common\BDLsp.Common.dproj;Packages\BDLsp.Windows\BDLsp.Windows.dproj</Dependencies>
        </Projects>
        <Projects Include="Packages\BDLsp.IdePlugin\BDLsp.IdePlugin.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tests\BDLsp.Tests.dproj">
            <Dependencies>Packages\BDLsp.Common\BDLsp.Common.dproj;Packages\BDLsp.Windows\BDLsp.Windows.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="BDLsp_Common">
        <MSBuild Projects="Packages\BDLsp.Common\BDLsp.Common.dproj"/>
    </Target>
    <Target Name="BDLsp_Common:Clean">
        <MSBuild Projects="Packages\BDLsp.Common\BDLsp.Common.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BDLsp_Common:Make">
        <MSBuild Projects="Packages\BDLsp.Common\BDLsp.Common.dproj" Targets="Make"/>
    </Target>
    <Target Name="BDLsp_Windows">
        <MSBuild Projects="Packages\BDLsp.Windows\BDLsp.Windows.dproj"/>
    </Target>
    <Target Name="BDLsp_Windows:Clean">
        <MSBuild Projects="Packages\BDLsp.Windows\BDLsp.Windows.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BDLsp_Windows:Make">
        <MSBuild Projects="Packages\BDLsp.Windows\BDLsp.Windows.dproj" Targets="Make"/>
    </Target>
    <Target Name="BetterDelphiLSP">
        <MSBuild Projects="Application\BetterDelphiLSP.dproj"/>
    </Target>
    <Target Name="BetterDelphiLSP:Clean">
        <MSBuild Projects="Application\BetterDelphiLSP.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BetterDelphiLSP:Make">
        <MSBuild Projects="Application\BetterDelphiLSP.dproj" Targets="Make"/>
    </Target>
    <Target Name="BDLsp_IdePlugin">
        <MSBuild Projects="Packages\BDLsp.IdePlugin\BDLsp.IdePlugin.dproj"/>
    </Target>
    <Target Name="BDLsp_IdePlugin:Clean">
        <MSBuild Projects="Packages\BDLsp.IdePlugin\BDLsp.IdePlugin.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BDLsp_IdePlugin:Make">
        <MSBuild Projects="Packages\BDLsp.IdePlugin\BDLsp.IdePlugin.dproj" Targets="Make"/>
    </Target>
    <Target Name="BDLsp_Tests">
        <MSBuild Projects="Tests\BDLsp.Tests.dproj"/>
    </Target>
    <Target Name="BDLsp_Tests:Clean">
        <MSBuild Projects="Tests\BDLsp.Tests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BDLsp_Tests:Make">
        <MSBuild Projects="Tests\BDLsp.Tests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="BDLsp_Common;BDLsp_Windows;BetterDelphiLSP;BDLsp_IdePlugin;BDLsp_Tests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="BDLsp_Common:Clean;BDLsp_Windows:Clean;BetterDelphiLSP:Clean;BDLsp_IdePlugin:Clean;BDLsp_Tests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="BDLsp_Common:Make;BDLsp_Windows:Make;BetterDelphiLSP:Make;BDLsp_IdePlugin:Make;BDLsp_Tests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
