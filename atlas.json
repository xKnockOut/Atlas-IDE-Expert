{
  "project": "Tests/Atlas.Tests.dproj",
  "minDelphiVersion": "23.0",
  "exclude": ["Tools/Linux/Compat/**", "Tests/Compilermeldungen/Faelle/**", "Tests/DccFaelle/**",
    "Tests/Referenzprojekt/**", "Tests/**/*Golden.pas", "Setup/Beispiele/**"],
  "rules": {
    "metric-method-length": "off",
    "metric-nesting-depth": "off",
    "metric-cyclomatic-complexity": "off",
    "metric-cognitive-complexity": "off",
    "metric-parameter-count": "off",
    "metric-boolean-operands": "off",
    "metric-local-count": "off",
    "metric-exit-points": "off",
    "metric-class-size": "off",
    "metric-unit-length": "off",
    "metric-uses-count": "off",
    "metric-inheritance-depth": "off",
    "catch-all-without-raise": {"severity": "warning", "exclude": ["Tests/**", "Tools/**", "Application/**", "Packages/Atlas.IDE.*/**"]},
    "narrowing-assignment": "off",
    "generic-exception-raised": {"exclude": ["Tests/**"]},
    "format-without-settings": {"exclude": ["Tests/**"]},
    "security-insecure-http": {"exclude": ["Tests/**"]},
    "security-hardcoded-credential": {"exclude": ["Tests/**", "**/Atlas.Common.Rules.Catalog.Data.*"]},
    "control-fixed-bounds": {"exclude": ["Tests/**"]},
    "unused-unit": {"exclude": ["Tests/**/*Golden.pas"]},
    "loop-runs-at-most-once": {
      "allowFirstElement": true
    },
    "architecture-role-import": {
      "severity": "warning",
      "exclude": ["Tests/**"],
      "prefixes": ["Atlas.Text", "Atlas.Common", "Atlas.Windows", "Atlas.Core", "Atlas.UI", "Atlas.IDE"],
      "allow": [
        "Atlas.Common.Rules.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Semantics.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Documents.Contract -> Atlas.Text.Lines",
        "Atlas.IDE.CodeInsight.Composition.Adapters -> Atlas.Core.*",
        "Atlas.IDE.Debug.Composition -> Atlas.Core.*",
        "Atlas.IDE.BuildTools.Composition -> Atlas.Core.*",
        "Atlas.IDE.Tests.Composition -> Atlas.Core.*",
        "Atlas.IDE.Tracker.Composition -> Atlas.Core.*",
        "Atlas.IDE.VersionControl.Composition -> Atlas.Core.*",
        "Atlas.IDE.Contracts.VersionControl -> Atlas.Core.VersionControl.Providers.Null"
      ]
    },
    "architecture-contract-content": {
      "severity": "warning",
      "exclude": ["Tests/**"],
      "prefixes": ["Atlas.Text", "Atlas.Common", "Atlas.Windows", "Atlas.Core", "Atlas.UI", "Atlas.IDE"],
      "allow": ["Atlas.Common.Dfm.Contract.TDfm*"]
    },
    "forbidden-symbol": {
      "severity": "error",
      "exclude": ["Tests/**", "Tools/**"],
      "symbols": [
        {"name": "System.Write", "kind": "routine", "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": ["ErrOutput", "TextFile", "Text"]},
        {"name": "System.Writeln", "kind": "routine", "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": ["ErrOutput", "TextFile", "Text"]},
        {"name": "Winapi.Windows.GetStdHandle", "message": "stdout-Handle nur über TStdStreams",
          "firstArgument": ["STD_OUTPUT_HANDLE"], "units": ["!Atlas.Windows.Console.StdStreams"]},
        {"name": "System.Classes.TThread.Queue", "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.Queue verwenden",
          "firstArgument": ["nil"], "units": ["Atlas.Core.*", "Atlas.UI.*", "Atlas.IDE.*"]},
        {"name": "System.Classes.TThread.ForceQueue", "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.ForceQueue verwenden",
          "firstArgument": ["nil"], "units": ["Atlas.Core.*", "Atlas.UI.*", "Atlas.IDE.*"]},
        {"name": "Winapi.Windows.GetTickCount", "message": "32-Bit-Zähler läuft nach 49,7 Tagen über, TAtlasTicks bzw. TAtlasDeadline verwenden",
          "units": ["!Atlas.Core.Diagnostics.UserIdle"]},
        {"name": "System.Classes.TThread.GetTickCount", "message": "32-Bit-Zähler läuft nach 49,7 Tagen über, TAtlasTicks bzw. TAtlasDeadline verwenden"},
        {"name": "Winapi.Windows.CreateProcess", "message": "Kindprozesse über TAtlasProcessLauncher.Launch starten: vererbt nur die Standard-Handles (Handle-Liste)",
          "units": ["!Atlas.WinBase.Process"]}
      ]
    }
  }
}
