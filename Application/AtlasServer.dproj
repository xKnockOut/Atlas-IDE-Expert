        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_MapFile>3</DCC_MapFile>
        <SanitizedProjectName>AtlasServer</SanitizedProjectName>
        <DCC_Namespace>System;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\Output\$(Platform)\$(Config)\Dcu\Atlas.Text;..\Output\$(Platform)\$(Config)\Dcu\Atlas.Common;..\Output\$(Platform)\$(Config)\Dcu\Atlas.Windows;..\Output\$(Platform)\$(Config)\Dcu\Atlas.WinBase;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
