class function TAtlasIssueStrings.Text(AId: TAtlasIssueTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasIssueStrings.Fmt(AId: TAtlasIssueTextId; const AArgs: array of const): string;
begin
  Result := Format(cTexts[TAtlasStrings.Language, AId], AArgs);
end;

end.
