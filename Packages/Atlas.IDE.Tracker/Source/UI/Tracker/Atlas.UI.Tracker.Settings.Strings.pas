class function TAtlasOptionsStrings.Text(AId: TAtlasOptionsTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasOptionsStrings.Fmt(AId: TAtlasOptionsTextId; const AArgs: array of const): string;
begin
  Result := Format(cTexts[TAtlasStrings.Language, AId], AArgs);
end;

end.
