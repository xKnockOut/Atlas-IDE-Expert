class function TAtlasMyIssuesStrings.Text(AId: TAtlasMyIssuesTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasMyIssuesStrings.Fmt(AId: TAtlasMyIssuesTextId; const AArgs: array of const): string;
begin
  Result := Format(cTexts[TAtlasStrings.Language, AId], AArgs);
end;

end.
