package Atlas.IDE.Tracker;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Issue-Tracker und Build-Server'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Issue-Tracker und Build-Server (#1456, ADR 0017): Verbindungen, Meine Issues, Sprint, Board,
// Vorschau, Zeiterfassung, Testergebnisse vom Build-Server und Fehlerberichte als Issue.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.Tracker.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package und
// Atlas.IDE.Contracts, kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base,
  Atlas.IDE.Contracts;

contains
  Atlas.UI.Tracker.QueryDialog in 'Source\UI\Tracker\Atlas.UI.Tracker.QueryDialog.pas',
  Atlas.UI.Tracker.SettingsRows in 'Source\UI\Tracker\Atlas.UI.Tracker.SettingsRows.pas',
