{
  "$schema": "https://raw.githubusercontent.com/xKnockOut/Atlas-IDE-Expert/main/schemas/atlas.schema.json",
  "profile": "strict",
  "minConfidence": "low",
  "testProfile": "standard",
  "exclude": [
    "__history/**",
    "__recovery/**"
  ],
  "rules": {
    "loop-runs-at-most-once": {
      "allowFirstElement": true
    },
    "catch-all-without-raise": "off",
    "narrowing-assignment": "off",
    "architecture-role-import": {
      "severity": "warning",
      "exclude": [
        "Tests/**"
      ],
      "prefixes": [
        "Atlas.Text",
        "Atlas.Common",
        "Atlas.Windows",
        "Atlas.Core",
        "Atlas.UI",
        "Atlas.IDE"
      ],
      "allow": [
        "Atlas.Common.Rules.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Semantics.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Documents.Contract -> Atlas.Text.Lines",
        "Atlas.IDE.CodeInsight.Composition.Adapters -> Atlas.Core.*",
        "Atlas.IDE.Debug.Composition -> Atlas.Core.*",
        "Atlas.IDE.BuildTools.Composition -> Atlas.Core.*",
        "Atlas.IDE.Tests.Composition -> Atlas.Core.*",
        "Atlas.IDE.Tracker.Composition -> Atlas.Core.*",
        "Atlas.IDE.VersionControl.Composition -> Atlas.Core.*",
        "Atlas.IDE.Contracts.VersionControl -> Atlas.Core.VersionControl.Providers.Null"
      ]
    },
    "architecture-contract-content": {
      "severity": "warning",
      "exclude": [
        "Tests/**"
      ],
      "prefixes": [
        "Atlas.Text",
        "Atlas.Common",
        "Atlas.Windows",
        "Atlas.Core",
        "Atlas.UI",
        "Atlas.IDE"
      ],
      "allow": [
        "Atlas.Common.Dfm.Contract.TDfm*"
      ]
    },
    "forbidden-symbol": {
      "severity": "error",
      "exclude": [
        "Tests/**",
        "Tools/**"
      ],
      "symbols": [
        {
          "name": "System.Write",
          "kind": "routine",
          "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": [
            "ErrOutput",
            "TextFile",
            "Text"
          ]
        },
        {
          "name": "System.Writeln",
          "kind": "routine",
          "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": [
            "ErrOutput",
            "TextFile",
            "Text"
          ]
        },
        {
          "name": "Winapi.Windows.GetStdHandle",
          "message": "stdout-Handle nur über TStdStreams",
          "firstArgument": [
            "STD_OUTPUT_HANDLE"
          ],
          "units": [
            "!Atlas.Windows.Console.StdStreams"
          ]
        },
        {
          "name": "System.Classes.TThread.Queue",
          "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.Queue verwenden",
          "firstArgument": [
            "nil"
          ],
          "units": [
            "Atlas.Core.*",
            "Atlas.UI.*",
            "Atlas.IDE.*"
          ]
        },
        {
          "name": "System.Classes.TThread.ForceQueue",
          "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.ForceQueue verwenden",
          "firstArgument": [
            "nil"
          ],
          "units": [
            "Atlas.Core.*",
            "Atlas.UI.*",
            "Atlas.IDE.*"
          ]
        }
      ]
    }
  }
}
