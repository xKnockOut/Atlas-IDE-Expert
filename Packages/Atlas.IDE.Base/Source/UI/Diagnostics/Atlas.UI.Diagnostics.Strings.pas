    ReportIssueDone, ReportViewerTitle, ReportSizeBytes, ReportSizeKb, ReportSizeMb, BugReportCollecting,
    ProcessesTitle, ProcessesTitleNone, ProcessesWrites, ProcessesFree, ProcessesSaved, ProcessesOwn,
    ProcessesBuiltOnce, ProcessesUnits, ProcessesCount, ProcessesDirtyCaption, ProcessesDirtyIdeText,
    ProcessesDirtyMcpText, ProcessesDirtyNone, ProcessesDirtyNote, ProcessesLog, ProcessesRefresh, ProcessesCopy,
    ProcessesClose, ProcessesEmpty, ProcessesAsking, ServerPackageTitle, ServerPackageHint, ServerPackageFilter,
