class function TAtlasDiagnosticsStrings.Text(AId: TAtlasDiagnosticsTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasDiagnosticsStrings.Fmt(AId: TAtlasDiagnosticsTextId; const AArgs: array of const): string;
begin
  Result := Format(Text(AId), AArgs);
end;

end.
