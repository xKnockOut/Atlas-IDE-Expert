    DiagnosticRowContext, DiagnosticRowProvider, DiagnosticRowFilter, DiagnosticRowDraw, DiagnosticRowFirst,
    DiagnosticRowEntries, DiagnosticLastQuery, DiagnosticNoQuery, DiagnosticLegend, DiagnosticFileNames,
