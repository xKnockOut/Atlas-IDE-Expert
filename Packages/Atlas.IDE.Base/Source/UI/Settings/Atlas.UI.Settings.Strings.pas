{ TAtlasSettingsStrings }

class function TAtlasSettingsStrings.Text(AId: TAtlasSettingsTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasSettingsStrings.Fmt(AId: TAtlasSettingsTextId; const AArgs: array of const): string;
begin
  Result := Format(Text(AId), AArgs);
end;

end.
