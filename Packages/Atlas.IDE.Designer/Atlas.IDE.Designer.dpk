package Atlas.IDE.Designer;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Designer'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Designer (#1456, ADR 0017): Leiste, Komponentensuche und Reiterhinweise im Formular-Designer.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.Designer.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package
// (mit den Verträgen zwischen Modulen), kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base;

contains
  Atlas.UI.Designer.Strings in 'Source\UI\Designer\Atlas.UI.Designer.Strings.pas',
  Atlas.Core.Designer.ButtonBar in 'Source\Core\Designer\Atlas.Core.Designer.ButtonBar.pas',
  Atlas.Core.Designer.Components in 'Source\Core\Designer\Atlas.Core.Designer.Components.pas',
  Atlas.Core.Designer.DuplicateRow in 'Source\Core\Designer\Atlas.Core.Designer.DuplicateRow.pas',
  Atlas.Core.Designer.FitText in 'Source\Core\Designer\Atlas.Core.Designer.FitText.pas',
  Atlas.Core.Designer.FormModel in 'Source\Core\Designer\Atlas.Core.Designer.FormModel.pas',
  Atlas.Core.Designer.Neighbours in 'Source\Core\Designer\Atlas.Core.Designer.Neighbours.pas',
  Atlas.Core.Designer.SelectionSets in 'Source\Core\Designer\Atlas.Core.Designer.SelectionSets.pas',
  Atlas.Core.Designer.Similar in 'Source\Core\Designer\Atlas.Core.Designer.Similar.pas',
  Atlas.UI.Designer.Flash in 'Source\UI\Designer\Atlas.UI.Designer.Flash.pas',
  Atlas.UI.Designer.Outlines in 'Source\UI\Designer\Atlas.UI.Designer.Outlines.pas',
  Atlas.UI.Designer.DuplicateDialog in 'Source\UI\Designer\Atlas.UI.Designer.DuplicateDialog.pas',
  Atlas.UI.Designer.Bar in 'Source\UI\Designer\Atlas.UI.Designer.Bar.pas',
  Atlas.UI.Designer.Search in 'Source\UI\Designer\Atlas.UI.Designer.Search.pas',
  Atlas.UI.Designer.TabOverlay in 'Source\UI\Designer\Atlas.UI.Designer.TabOverlay.pas',
  Atlas.IDE.Designer.Access in 'Source\IDE\Designer\Atlas.IDE.Designer.Access.pas',
  Atlas.IDE.Designer.FitText in 'Source\IDE\Designer\Atlas.IDE.Designer.FitText.pas',
  Atlas.IDE.Designer.ButtonBar in 'Source\IDE\Designer\Atlas.IDE.Designer.ButtonBar.pas',
  Atlas.IDE.Designer.DuplicateRow in 'Source\IDE\Designer\Atlas.IDE.Designer.DuplicateRow.pas',
  Atlas.IDE.Designer.Arrange in 'Source\IDE\Designer\Atlas.IDE.Designer.Arrange.pas',
  Atlas.IDE.Designer.Navigate in 'Source\IDE\Designer\Atlas.IDE.Designer.Navigate.pas',
  Atlas.IDE.Designer.SelectionSets in 'Source\IDE\Designer\Atlas.IDE.Designer.SelectionSets.pas',
  Atlas.IDE.Designer.Select in 'Source\IDE\Designer\Atlas.IDE.Designer.Select.pas',
  Atlas.IDE.Designer.Commands in 'Source\IDE\Designer\Atlas.IDE.Designer.Commands.pas',
  Atlas.IDE.Designer.SearchItems in 'Source\IDE\Designer\Atlas.IDE.Designer.SearchItems.pas',
  Atlas.IDE.Designer.Bar in 'Source\IDE\Designer\Atlas.IDE.Designer.Bar.pas',
  Atlas.IDE.Designer.Composition in 'Source\IDE\Designer\Atlas.IDE.Designer.Composition.pas',
  Atlas.UI.Designer.SettingsSection in 'Source\UI\Designer\Atlas.UI.Designer.SettingsSection.pas';

end.
