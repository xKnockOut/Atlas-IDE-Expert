package Atlas.IDE.Designer;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Designer'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Designer (#1456, ADR 0017): Leiste, Komponentensuche und Reiterhinweise im Formular-Designer.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.Designer.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package und
// Atlas.IDE.Contracts, kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base,
  Atlas.IDE.Contracts;

contains
  Atlas.UI.Designer.Strings in 'Source\UI\Designer\Atlas.UI.Designer.Strings.pas',
  Atlas.Core.Designer.Components in 'Source\Core\Designer\Atlas.Core.Designer.Components.pas',
  Atlas.UI.Designer.Bar in 'Source\UI\Designer\Atlas.UI.Designer.Bar.pas',
  Atlas.UI.Designer.Search in 'Source\UI\Designer\Atlas.UI.Designer.Search.pas',
  Atlas.UI.Designer.TabOverlay in 'Source\UI\Designer\Atlas.UI.Designer.TabOverlay.pas',
  Atlas.IDE.Designer.Bar in 'Source\IDE\Designer\Atlas.IDE.Designer.Bar.pas',
  Atlas.IDE.Designer.Composition in 'Source\IDE\Designer\Atlas.IDE.Designer.Composition.pas';

end.
