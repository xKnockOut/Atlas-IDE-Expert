<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{C139BCC3-A7F7-4911-99A6-B2B9011E7F9F}</ProjectGuid>
        <MainSource>Atlas.IDE.Bookmarks.dpk</MainSource>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Package</AppType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <ProjectName Condition="'$(ProjectName)'==''">Atlas.IDE.Bookmarks</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64x' and '$(Base)'=='true') or '$(Base_Win64x)'!=''">
        <Base_Win64x>true</Base_Win64x>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>Atlas_IDE_Bookmarks</SanitizedProjectName>
        <DCC_MapFile>3</DCC_MapFile>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <GenPackage>true</GenPackage>
        <GenDll>true</GenDll>
        <DesignOnlyPackage>true</DesignOnlyPackage>
        <DllSuffix>$(Auto)</DllSuffix>
        <DCC_Description>Atlas IDE Expert – Lesezeichen</DCC_Description>
        <DCC_Namespace>System;Winapi;System.Win;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
        <DCC_DcuOutput>..\..\Output\$(Platform)\$(Config)\Dcu\Atlas.IDE.Bookmarks</DCC_DcuOutput>
        <DCC_DcpOutput>..\..\Output\$(Platform)\$(Config)\Dcp</DCC_DcpOutput>
        <DCC_UnitSearchPath>..\..\Output\$(Platform)\$(Config)\Dcp;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_BplOutput>..\..\Output\$(Platform)\$(Config)\Bpl</DCC_BplOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64x)'!=''">
        <DCC_Namespace>Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=;FileDescription=$(MSBuildProjectName);FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.embarcadero.$(MSBuildProjectName);ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <BCC_EnableBatchCompilation>true</BCC_EnableBatchCompilation>
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>false</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="vclwinx.dcp"/>
        <DCCReference Include="designide.dcp"/>
        <DCCReference Include="Atlas.IDE.Base.dcp"/>
        <DCCReference Include="Source\Core\Bookmarks\Atlas.Core.Bookmarks.Quick.pas"/>
        <DCCReference Include="Source\Core\Bookmarks\Atlas.Core.Bookmarks.SavedPlaces.pas"/>
        <DCCReference Include="Source\Core\Bookmarks\Atlas.Core.Bookmarks.Store.pas"/>
        <DCCReference Include="Source\Core\Marks\Atlas.Core.Marks.Ids.pas"/>
        <DCCReference Include="Source\Core\Notes\Atlas.Core.Notes.Store.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.Gutter.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.Composition.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.Composition.Todos.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.QuickChord.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.QuickColumn.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.QuickPopups.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.SavedPlaces.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.Service.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.QuickService.pas"/>
        <DCCReference Include="Source\IDE\Bookmarks\Atlas.IDE.Bookmarks.Window.pas"/>
        <DCCReference Include="Source\IDE\Notes\Atlas.IDE.Notes.Gutter.pas"/>
        <DCCReference Include="Source\IDE\Notes\Atlas.IDE.Notes.Service.pas"/>
        <DCCReference Include="Source\UI\Bookmarks\Atlas.UI.Bookmarks.Dialog.pas"/>
        <DCCReference Include="Source\UI\Bookmarks\Atlas.UI.Bookmarks.Frame.pas">
            <Form>AtlasBookmarksFrame</Form>
            <FormType>dfm</FormType>
            <DesignClass>TFrame</DesignClass>
        </DCCReference>
        <DCCReference Include="Source\UI\Bookmarks\Atlas.UI.Bookmarks.Strings.pas"/>
        <DCCReference Include="Source\UI\Notes\Atlas.UI.Notes.Dialog.pas"/>
        <DCCReference Include="Source\UI\Notes\Atlas.UI.Notes.List.pas"/>
        <DCCReference Include="Source\UI\Todos\Atlas.UI.Todos.Dialog.pas"/>
        <DCCReference Include="Source\UI\Bookmarks\Atlas.UI.Bookmarks.SettingsSection.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Atlas.IDE.Bookmarks.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
                <Platform value="Win64x">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
