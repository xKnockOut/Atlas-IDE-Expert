{
  "$schema": "https://raw.githubusercontent.com/xKnockOut/Atlas/main/schemas/atlas.schema.json",
  "profile": "strict",
  "minConfidence": "low",
  "testProfile": "standard",
  "exclude": ["__history/**", "__recovery/**"],
  "rules": {
    "loop-runs-at-most-once": {"allowFirstElement": true},
    "catch-all-without-raise": "off",
    "narrowing-assignment": "off"
  }
}
