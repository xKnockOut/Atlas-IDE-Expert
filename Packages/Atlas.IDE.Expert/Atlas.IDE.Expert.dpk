  Atlas.IDE.Commands.MainMenu in 'Source\IDE\Commands\Atlas.IDE.Commands.MainMenu.pas',
  Atlas.Core.Completion.Ranking in 'Source\Core\Completion\Atlas.Core.Completion.Ranking.pas',
  Atlas.Core.Completion.Usage in 'Source\Core\Completion\Atlas.Core.Completion.Usage.pas',
  Atlas.IDE.Completion.History in 'Source\IDE\Completion\Atlas.IDE.Completion.History.pas',
  Atlas.UI.Strings in 'Source\UI\Atlas.UI.Strings.pas',
  Atlas.Core.Completion.Providers.XmlDoc in 'Source\Core\Completion\Providers\Atlas.Core.Completion.Providers.XmlDoc.pas',
  Atlas.Core.Completion.Parentheses in 'Source\Core\Completion\Atlas.Core.Completion.Parentheses.pas',
  Atlas.UI.Hover.Tip in 'Source\UI\Hover\Atlas.UI.Hover.Tip.pas',
  Atlas.IDE.Hover.Editor in 'Source\IDE\Hover\Atlas.IDE.Hover.Editor.pas',
  Atlas.Core.Completion.Preview in 'Source\Core\Completion\Atlas.Core.Completion.Preview.pas',
  Atlas.IDE.Completion.Preview in 'Source\IDE\Completion\Atlas.IDE.Completion.Preview.pas',
  Atlas.Core.Build.Events in 'Source\Core\Build\Atlas.Core.Build.Events.pas',
  Atlas.IDE.Build.Notifier in 'Source\IDE\Build\Atlas.IDE.Build.Notifier.pas',
  Atlas.Core.Diagnostics.Guard in 'Source\Core\Diagnostics\Atlas.Core.Diagnostics.Guard.pas',
  Atlas.Core.Diagnostics.Hangs in 'Source\Core\Diagnostics\Atlas.Core.Diagnostics.Hangs.pas',
  Atlas.IDE.Diagnostics.Watchdog in 'Source\IDE\Diagnostics\Atlas.IDE.Diagnostics.Watchdog.pas',
  Atlas.Core.Files.ExternalChanges in 'Source\Core\Files\Atlas.Core.Files.ExternalChanges.pas',
  Atlas.IDE.Files.Reloader in 'Source\IDE\Files\Atlas.IDE.Files.Reloader.pas',
  Atlas.Core.Commands.Palette in 'Source\Core\Commands\Atlas.Core.Commands.Palette.pas',
  Atlas.UI.Commands.Palette in 'Source\UI\Commands\Atlas.UI.Commands.Palette.pas',
  Atlas.IDE.Commands.Palette in 'Source\IDE\Commands\Atlas.IDE.Commands.Palette.pas',
  Atlas.Core.Editor.Pairs in 'Source\Core\Editor\Atlas.Core.Editor.Pairs.pas',
  Atlas.Core.Editor.Guides in 'Source\Core\Editor\Atlas.Core.Editor.Guides.pas',
  Atlas.Core.Problems.Contract in 'Source\Core\Problems\Atlas.Core.Problems.Contract.pas',
  Atlas.Core.Problems.Store in 'Source\Core\Problems\Atlas.Core.Problems.Store.pas',
  Atlas.IDE.Editor.Pairs in 'Source\IDE\Editor\Atlas.IDE.Editor.Pairs.pas',
  Atlas.IDE.Editor.Structure in 'Source\IDE\Editor\Atlas.IDE.Editor.Structure.pas',
  Atlas.IDE.Files.DirtyExport in 'Source\IDE\Files\Atlas.IDE.Files.DirtyExport.pas',
  Atlas.Core.Files.TextDiff in 'Source\Core\Files\Atlas.Core.Files.TextDiff.pas',
  Atlas.IDE.Problems.Painter in 'Source\IDE\Problems\Atlas.IDE.Problems.Painter.pas',
  Atlas.IDE.Problems.MessageList in 'Source\IDE\Problems\Atlas.IDE.Problems.MessageList.pas',
  Atlas.IDE.Problems.Controller in 'Source\IDE\Problems\Atlas.IDE.Problems.Controller.pas',
  Atlas.IDE.Build.MessageView in 'Source\IDE\Build\Atlas.IDE.Build.MessageView.pas',
  Atlas.Core.Build.Messages in 'Source\Core\Build\Atlas.Core.Build.Messages.pas',
  Atlas.Core.Build.CheckOnSave in 'Source\Core\Build\Atlas.Core.Build.CheckOnSave.pas',
  Atlas.IDE.Build.CheckOnSave in 'Source\IDE\Build\Atlas.IDE.Build.CheckOnSave.pas';

end.
