package Atlas.IDE.Expert;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert (Code Insight-Manager)'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}
{$LIBSUFFIX AUTO}
// Atlas-Symbol (#751): Symbole und PNG je Größe, erzeugt mit Resources\Symbol\Quellen\Erzeuge-Res.py.
{$R 'Resources\Symbol\Atlas.Symbol.res'}

// Design-Time-Package für RAD Studio (ADR 0006): meldet Atlas als
// Code Insight-Manager für Delphi an und spricht über eine eigene LSP-Sitzung
// mit dem Server. Win32 für die klassische IDE, Win64 für die 64-Bit-IDE
// (ADR 0008, #281). LIBSUFFIX AUTO hängt die Package-Version an
// (Atlas.IDE.Expert290.bpl für Delphi 12, …370.bpl für Delphi 13), damit die
// BPLs beider IDE-Versionen nebeneinander liegen können.
// Bewusst ohne Atlas.Common/Atlas.Windows: ein einzelnes Package, das die IDE
// ohne weitere BPLs laden kann (ADR 0012). Gemeinsamen Textcode mit dem Server
// (Atlas.Text) übersetzt das Plugin als Quelltext mit; die Liste unten muss
// alle Units von Atlas.Text.dpk enthalten (Tools\Check-PackageDependencies.ps1).

requires
  rtl,
  vcl,
  vclwinx,
  designide;

contains
  Atlas.Text.Product.Version in '..\Atlas.Text\Source\Product\Atlas.Text.Product.Version.pas',
  Atlas.Text.Lines in '..\Atlas.Text\Source\Lines\Atlas.Text.Lines.pas',
  Atlas.Text.Chars in '..\Atlas.Text\Source\Chars\Atlas.Text.Chars.pas',
