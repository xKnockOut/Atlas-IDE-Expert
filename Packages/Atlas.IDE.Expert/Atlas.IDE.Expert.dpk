package Atlas.IDE.Expert;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert (Code Insight-Manager)'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

// Design-Time-Package für RAD Studio (ADR 0006): meldet Atlas als
// Code Insight-Manager für Delphi an und spricht über eine eigene LSP-Sitzung
// mit dem Server. Nur Win32, weil die IDE (bds.exe) 32-Bit ist.
// Bewusst ohne Atlas.Common/Atlas.Windows: ein einzelnes Package, das die IDE
// ohne weitere BPLs laden kann.

requires
  rtl,
  vcl,
  designide;

contains
  Atlas.Core.Lsp.Progress in 'Source\Core\Lsp\Atlas.Core.Lsp.Progress.pas',
  Atlas.Core.Lsp.Client in 'Source\Core\Lsp\Atlas.Core.Lsp.Client.pas',
  Atlas.Core.Lsp.Session in 'Source\Core\Lsp\Atlas.Core.Lsp.Session.pas',
  Atlas.Core.Lsp.Adapters.ServerProcess in 'Source\Core\Lsp\Atlas.Core.Lsp.Adapters.ServerProcess.pas',
  Atlas.Core.Completion.Contract in 'Source\Core\Completion\Atlas.Core.Completion.Contract.pas',
  Atlas.Core.Completion.Internals.Async in 'Source\Core\Completion\Internals\Atlas.Core.Completion.Internals.Async.pas',
  Atlas.Core.Completion.Composite in 'Source\Core\Completion\Atlas.Core.Completion.Composite.pas',
  Atlas.Core.Completion.Providers.Fixed in 'Source\Core\Completion\Providers\Atlas.Core.Completion.Providers.Fixed.pas',
  Atlas.Core.Completion.Providers.Server in 'Source\Core\Completion\Providers\Atlas.Core.Completion.Providers.Server.pas',
  Atlas.Core.Completion.Matching in 'Source\Core\Completion\Atlas.Core.Completion.Matching.pas',
  Atlas.Core.Completion.Controller in 'Source\Core\Completion\Atlas.Core.Completion.Controller.pas',
  Atlas.Core.Signature.Contract in 'Source\Core\Signature\Atlas.Core.Signature.Contract.pas',
  Atlas.Core.Hover.Contract in 'Source\Core\Hover\Atlas.Core.Hover.Contract.pas',
  Atlas.Core.Hover.History in 'Source\Core\Hover\Atlas.Core.Hover.History.pas',
  Atlas.Core.Signature.CallScanner in 'Source\Core\Signature\Atlas.Core.Signature.CallScanner.pas',
  Atlas.Core.Signature.Controller in 'Source\Core\Signature\Atlas.Core.Signature.Controller.pas',
  Atlas.Core.Signature.Providers.Server in 'Source\Core\Signature\Atlas.Core.Signature.Providers.Server.pas',
  Atlas.UI.Signature.Hint in 'Source\UI\Signature\Atlas.UI.Signature.Hint.pas',
  Atlas.UI.Popup.Window in 'Source\UI\Popup\Atlas.UI.Popup.Window.pas',
  Atlas.UI.Popup.Accessibility in 'Source\UI\Popup\Atlas.UI.Popup.Accessibility.pas',
  Atlas.UI.Completion.Popup in 'Source\UI\Completion\Atlas.UI.Completion.Popup.pas',
  Atlas.UI.Completion.Details in 'Source\UI\Completion\Atlas.UI.Completion.Details.pas',
  Atlas.Core.Style.Color in 'Source\Core\Style\Atlas.Core.Style.Color.pas',
  Atlas.Core.Style.Palette in 'Source\Core\Style\Atlas.Core.Style.Palette.pas',
  Atlas.Core.Style.Syntax in 'Source\Core\Style\Atlas.Core.Style.Syntax.pas',
  Atlas.Core.Style.Scaling in 'Source\Core\Style\Atlas.Core.Style.Scaling.pas',
  Atlas.Core.Completion.Presentation in 'Source\Core\Completion\Atlas.Core.Completion.Presentation.pas',
  Atlas.Core.Completion.Word in 'Source\Core\Completion\Atlas.Core.Completion.Word.pas',
  Atlas.UI.Popup.Styled in 'Source\UI\Popup\Atlas.UI.Popup.Styled.pas',
  Atlas.UI.Popup.Tip in 'Source\UI\Popup\Atlas.UI.Popup.Tip.pas',
  Atlas.IDE.Editor.Style in 'Source\IDE\Editor\Atlas.IDE.Editor.Style.pas',
  Atlas.IDE.Editor.Buffer in 'Source\IDE\Editor\Atlas.IDE.Editor.Buffer.pas',
  Atlas.IDE.Editor.KeyHook in 'Source\IDE\Editor\Atlas.IDE.Editor.KeyHook.pas',
  Atlas.IDE.Signature.Editor in 'Source\IDE\Signature\Atlas.IDE.Signature.Editor.pas',
  Atlas.IDE.Completion.Editor in 'Source\IDE\Completion\Atlas.IDE.Completion.Editor.pas',
  Atlas.IDE.CodeInsight.Manager in 'Source\IDE\CodeInsight\Atlas.IDE.CodeInsight.Manager.pas',
  Atlas.IDE.CodeInsight.Composition in 'Source\IDE\CodeInsight\Atlas.IDE.CodeInsight.Composition.pas',
  Atlas.Core.Settings.Plugin in 'Source\Core\Settings\Atlas.Core.Settings.Plugin.pas',
  Atlas.UI.Settings.Page in 'Source\UI\Settings\Atlas.UI.Settings.Page.pas' {AtlasSettingsPage: TFrame},
  Atlas.IDE.Settings.Store in 'Source\IDE\Settings\Atlas.IDE.Settings.Store.pas',
  Atlas.IDE.Settings.Options in 'Source\IDE\Settings\Atlas.IDE.Settings.Options.pas',
  Atlas.Core.Settings.JsonText in 'Source\Core\Settings\Atlas.Core.Settings.JsonText.pas',
  Atlas.Core.Settings.Schema in 'Source\Core\Settings\Atlas.Core.Settings.Schema.pas',
  Atlas.Core.Settings.SchemaData in 'Source\Core\Settings\Atlas.Core.Settings.SchemaData.pas',
  Atlas.UI.Settings.ProjectDialog in 'Source\UI\Settings\Atlas.UI.Settings.ProjectDialog.pas',
  Atlas.IDE.Settings.Project in 'Source\IDE\Settings\Atlas.IDE.Settings.Project.pas',
  Atlas.Core.Commands.KeyConflicts in 'Source\Core\Commands\Atlas.Core.Commands.KeyConflicts.pas',
