  Atlas.IDE.Welcome.QuickActions in 'Source\IDE\Welcome\Atlas.IDE.Welcome.QuickActions.pas',
  Atlas.IDE.Welcome.State in 'Source\IDE\Welcome\Atlas.IDE.Welcome.State.pas',
  Atlas.IDE.Welcome.Discover in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Discover.pas',
  Atlas.IDE.Welcome.Help in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Help.pas',
  Atlas.IDE.Welcome.Setup in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Setup.pas',
  Atlas.IDE.Welcome.Layouts in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Layouts.pas',
  Atlas.IDE.Welcome.Tiles in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Tiles.pas',
  Atlas.IDE.Welcome.TileProjects in 'Source\IDE\Welcome\Atlas.IDE.Welcome.TileProjects.pas',
  Atlas.IDE.Welcome.Composition in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Composition.pas',
  Atlas.IDE.Welcome.Startup in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Startup.pas',
  Atlas.IDE.Welcome.Listener in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Listener.pas',
  Atlas.IDE.Welcome.Settings in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Settings.pas',
  Atlas.IDE.Welcome.Neighbors in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Neighbors.pas',
  Atlas.IDE.Welcome.Commands in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Commands.pas';

end.
