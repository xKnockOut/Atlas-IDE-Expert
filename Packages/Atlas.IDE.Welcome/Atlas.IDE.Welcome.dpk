  Atlas.Core.Welcome.HostLayout in 'Source\Core\Welcome\Atlas.Core.Welcome.HostLayout.pas',
  Atlas.Core.Welcome.IndexFiles in 'Source\Core\Welcome\Atlas.Core.Welcome.IndexFiles.pas',
  Atlas.Core.Welcome.Search in 'Source\Core\Welcome\Atlas.Core.Welcome.Search.pas',
  Atlas.Core.Welcome.WhatsNew in 'Source\Core\Welcome\Atlas.Core.Welcome.WhatsNew.pas',
  Atlas.Core.Welcome.Projects in 'Source\Core\Welcome\Atlas.Core.Welcome.Projects.pas',
  Atlas.Core.Welcome.Trends in 'Source\Core\Welcome\Atlas.Core.Welcome.Trends.pas',
  Atlas.Core.Welcome.Unsaved in 'Source\Core\Welcome\Atlas.Core.Welcome.Unsaved.pas',
  Atlas.Core.Welcome.Continue in 'Source\Core\Welcome\Atlas.Core.Welcome.Continue.pas',
  Atlas.Core.Welcome.QuickActions in 'Source\Core\Welcome\Atlas.Core.Welcome.QuickActions.pas',
  Atlas.Core.Welcome.Saved in 'Source\Core\Welcome\Atlas.Core.Welcome.Saved.pas',
  Atlas.Core.Welcome.State in 'Source\Core\Welcome\Atlas.Core.Welcome.State.pas',
  Atlas.Core.Welcome.Discover in 'Source\Core\Welcome\Atlas.Core.Welcome.Discover.pas',
  Atlas.Core.Welcome.Help in 'Source\Core\Welcome\Atlas.Core.Welcome.Help.pas',
  Atlas.Core.Welcome.Setup in 'Source\Core\Welcome\Atlas.Core.Welcome.Setup.pas',
  Atlas.UI.Welcome.Frame in 'Source\UI\Welcome\Atlas.UI.Welcome.Frame.pas' {AtlasWelcomeFrame: TFrame},
  Atlas.UI.Welcome.Search in 'Source\UI\Welcome\Atlas.UI.Welcome.Search.pas',
  Atlas.UI.Welcome.Header in 'Source\UI\Welcome\Atlas.UI.Welcome.Header.pas',
  Atlas.UI.Welcome.Arrange in 'Source\UI\Welcome\Atlas.UI.Welcome.Arrange.pas',
  Atlas.UI.Welcome.Board in 'Source\UI\Welcome\Atlas.UI.Welcome.Board.pas',
  Atlas.UI.Welcome.WhatsNew in 'Source\UI\Welcome\Atlas.UI.Welcome.WhatsNew.pas',
  Atlas.UI.Welcome.Projects in 'Source\UI\Welcome\Atlas.UI.Welcome.Projects.pas',
  Atlas.UI.Welcome.Trends in 'Source\UI\Welcome\Atlas.UI.Welcome.Trends.pas',
  Atlas.UI.Welcome.Unsaved in 'Source\UI\Welcome\Atlas.UI.Welcome.Unsaved.pas',
  Atlas.UI.Welcome.Continue in 'Source\UI\Welcome\Atlas.UI.Welcome.Continue.pas',
  Atlas.UI.Welcome.QuickActions in 'Source\UI\Welcome\Atlas.UI.Welcome.QuickActions.pas',
  Atlas.UI.Welcome.SettingsLayouts in 'Source\UI\Welcome\Atlas.UI.Welcome.SettingsLayouts.pas',
  Atlas.UI.Welcome.SettingsSection in 'Source\UI\Welcome\Atlas.UI.Welcome.SettingsSection.pas',
  Atlas.UI.Welcome.State in 'Source\UI\Welcome\Atlas.UI.Welcome.State.pas',
  Atlas.UI.Welcome.Discover in 'Source\UI\Welcome\Atlas.UI.Welcome.Discover.pas',
  Atlas.UI.Welcome.Help in 'Source\UI\Welcome\Atlas.UI.Welcome.Help.pas',
  Atlas.UI.Welcome.Setup in 'Source\UI\Welcome\Atlas.UI.Welcome.Setup.pas',
  Atlas.UI.Welcome.SetupPreview in 'Source\UI\Welcome\Atlas.UI.Welcome.SetupPreview.pas',
  Atlas.UI.Welcome.Push in 'Source\UI\Welcome\Atlas.UI.Welcome.Push.pas',
  Atlas.IDE.Welcome.Registry in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Registry.pas',
  Atlas.IDE.Welcome.Window in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Window.pas',
  Atlas.IDE.Welcome.Page in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Page.pas',
  Atlas.IDE.Welcome.Search in 'Source\IDE\Welcome\Atlas.IDE.Welcome.Search.pas',
  Atlas.IDE.Welcome.WhatsNew in 'Source\IDE\Welcome\Atlas.IDE.Welcome.WhatsNew.pas',
