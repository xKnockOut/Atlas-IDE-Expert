package Atlas.IDE.Welcome;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Willkommensseite'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Willkommensseite (#1456, ADR 0017): Fenster „Atlas-Start“ und Bereiche auf der Willkommensseite
// der IDE, Weiterarbeiten, Projekte, Projektverlauf, Schnellaktionen, Atlas entdecken, Hilfe, Einrichten
// und ihr Abschnitt im Optionsdialog. Meldet sich in der Unit-Initialisierung von
// Atlas.IDE.Welcome.Composition über die Registry des Kern-Packages Atlas.IDE.Base an und lässt sich
// ohne Neustart der IDE laden und entladen (Regeln 1 bis 4). Requiret nur das Kern-Package und
// Atlas.IDE.Contracts, kein anderes Modul (Regel 9); Kacheln anderer Module kommen über Atlas.IDE.Contracts.WelcomeTiles.

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base,
  Atlas.IDE.Contracts;

contains
  Atlas.UI.Welcome.Strings in 'Source\UI\Welcome\Atlas.UI.Welcome.Strings.pas',
  Atlas.Core.Welcome.Sections in 'Source\Core\Welcome\Atlas.Core.Welcome.Sections.pas',
  Atlas.Core.Welcome.Layout in 'Source\Core\Welcome\Atlas.Core.Welcome.Layout.pas',
  Atlas.Core.Welcome.Layouts in 'Source\Core\Welcome\Atlas.Core.Welcome.Layouts.pas',
  Atlas.Core.Welcome.Greeting in 'Source\Core\Welcome\Atlas.Core.Welcome.Greeting.pas',
