    '    if (Math.abs(gOld - gNew) >= 0.005)',
    '      box.appendChild(el(''p'', { ''class'': ''muted'' }, ''Note: the saved state was calculated with granularity γ = '' + gammaText(gOld) +',
    '        '', the current one with γ = '' + gammaText(gNew) + ''; subsystem moves may come from that.''));',
    '    function cycleLine(c) { return c.units.join('' → '') + (c.units.length ? '' → '' + c.units[0] : '''') + (c.interfaceOnly ? '' (through interface only)'' : '' (through implementation)''); }',
    '    function edgeLine(e) { return e.source + '' → '' + e.target + '' ('' + e.section + '') '' + e.from + '' → '' + e.to + (e.reason ? '', '' + (e.reason === ''rare'' ? ''rare'' : ''against the main di' +
      'rection'') : ''''); }',
    '    function growthLine(g) { return g.unit + '': total dependents '' + g.before + '' → '' + g.after + '' (+'' + (g.after - g.before) + '')''; }',
    '    function moveLine(m) { return m.unit + '': '' + m.from + '' → '' + m.to; }',
    '    function ident(x) { return x; }',
    '    [[''New cycles'', C.newCycles, cycleLine, ''error''], [''Removed cycles'', C.removedCycles, cycleLine, ''added-text''],',
    '     [''New cross links'', C.newCrossLinks, edgeLine, ''error''], [''Removed cross links'', C.removedCrossLinks, edgeLine, ''added-text''],',
    '     [''New uses edges between subsystems'', C.newEdges, edgeLine, ''''], [''Removed uses edges between subsystems'', C.removedEdges, edgeLine, ''''],',
    '     [''Subsystem changes'', C.moves, moveLine, ''''], [''Grown central units'', C.growth, growthLine, ''''],',
    '     [''New units'', C.newUnits, ident, ''''], [''Removed units'', C.removedUnits, ident, '''']].forEach(function (sec) {',
    '      var d = el(''details''); d.open = sec[1].length > 0 && sec[1].length <= 20;',
    '      d.appendChild(el(''summary'', sec[1].length && sec[3] ? { ''class'': sec[3] } : {}, sec[0] + '' ('' + sec[1].length + '')''));',
    '      var ul = el(''ul''); sec[1].forEach(function (x) { ul.appendChild(el(''li'', { ''class'': ''mono'' }, sec[2](x))); });',
    '      if (!sec[1].length) ul.appendChild(el(''li'', { ''class'': ''muted'' }, ''None.''));',
    '      d.appendChild(ul); box.appendChild(d);',
    '    });',
    '  }',
    '',
    '  if (U.length > 1) { $(''from'').value = D.central.length ? D.central[D.central.length - 1] : order[0]; $(''to'').value = D.central.length ? D.central[0] : order[1]; }',
    '  draw(); fit();',
    '  window.addEventListener(''resize'', fit);',
    '})();',
    '</script>',
    '</body>',
    '</html>');

function ArchitectureMapHtmlEn: string;
var
  mLine: string;
begin
  Result := '';
  for mLine in cLines do
  begin
    Result := Result + mLine + #10;
  end;
end;

end.
