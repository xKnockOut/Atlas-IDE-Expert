    '    C.addedEdges.forEach(function (e) { var s = unitIndex[e[0].toLowerCase()], t = unitIndex[e[1].toLowerCase()]; if (s !== undefined && t !== undefined) addedLink[s + ''>'' + t] = true; });',
    '    C.droppedEdges.forEach(function (e) { var s = unitIndex[e[0].toLowerCase()], t = unitIndex[e[1].toLowerCase()]; if (s !== undefined && t !== undefined) droppedLinks.push({ s: s, t: t, k: e[2] }); ' +
      '});',
    '    $(''cmpBox'').hidden = false; $(''tocCompare'').hidden = false; $(''vergleich'').hidden = false;',
    '  }',
    '  var cycleOf = {};',
    '  D.cycles.forEach(function (c, i) { c.component.forEach(function (u) { if (cycleOf[u] === undefined) cycleOf[u] = i; }); });',
    '  var hidden = {}, expanded = {}, pathLinks = null, pathNodes = null, selected = -1;',
    '  var collapsed = U.length >= COLLAPSE_FROM;',
    '  if (collapsed) { $(''expand'').hidden = false; $(''hint'').textContent = ''Teilsysteme als Knoten: Doppelklick klappt eines auf · Ziehen verschiebt, Mausrad zoomt''; }',
    '  function isOpen(s) { return !collapsed || !!expanded[s]; }',
    '  function visibleUnit(u) { return !hidden[U[u].subsystem]; }',
    '',
    '  // Ansicht: Verschieben und Zoomen über eine Transformation',
    '  var svg = $(''svg''), view = $(''view''), tx = 0, ty = 0, scale = 1;',
    '  function applyView() {',
    '    view.setAttribute(''transform'', ''translate('' + tx + '','' + ty + '') scale('' + scale + '')'');',
    '    svg.classList.toggle(''far'', scale < 0.9);',
    '  }',
    '  function fit() {',
    '    var r = svg.getBoundingClientRect(), minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;',
    '    S.forEach(function (s) { minX = Math.min(minX, s.x - s.r); minY = Math.min(minY, s.y - s.r); maxX = Math.max(maxX, s.x + s.r); maxY = Math.max(maxY, s.y + s.r); });',
    '    if (!isFinite(minX)) return;',
    '    scale = Math.min(r.width / (maxX - minX + 40), r.height / (maxY - minY + 40), 2);',
    '    tx = r.width / 2 - (minX + maxX) / 2 * scale; ty = r.height / 2 - (minY + maxY) / 2 * scale; applyView();',
    '  }',
    '  svg.addEventListener(''wheel'', function (e) {',
    '    e.preventDefault();',
    '    var r = svg.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top, f = e.deltaY < 0 ? 1.15 : 1 / 1.15;',
    '    var ns = Math.max(0.05, Math.min(8, scale * f)); tx = mx - (mx - tx) * ns / scale; ty = my - (my - ty) * ns / scale; scale = ns; applyView();',
    '  }, { passive: false });',
    '  var drag = null;',
    '  svg.addEventListener(''pointerdown'', function (e) {',
    '    var t = e.target.closest(''[data-u]'');',
    '    drag = { x: e.clientX, y: e.clientY, tx: tx, ty: ty, u: t ? +t.getAttribute(''data-u'') : -1, moved: false, id: e.pointerId };',
    '  });',
    '  svg.addEventListener(''pointermove'', function (e) {',
    '    if (!drag) return;',
    '    var dx = e.clientX - drag.x, dy = e.clientY - drag.y;',
    '    // Erst beim Ziehen festhalten: Mit Pointer-Capture ginge der Klick an das SVG statt an die Unit.',
    '    if (!drag.moved && Math.abs(dx) + Math.abs(dy) > 3) { drag.moved = true; svg.setPointerCapture(drag.id); }',
    '    if (!drag.moved) return;',
    '    if (drag.u >= 0 && isOpen(U[drag.u].subsystem)) { U[drag.u].x += dx / scale; U[drag.u].y += dy / scale; drag.x = e.clientX; drag.y = e.clientY; draw(); }',
    '    else { tx = drag.tx + dx; ty = drag.ty + dy; applyView(); }',
    '  });',
    '  svg.addEventListener(''pointerup'', function () { setTimeout(function () { drag = null; }, 0); });',
    '',
    '  // Zeichnen; showFound: Kanten zum Fundament (#1365) zeigen.',
    '  var showFound = true;',
    '  function nodeRadius(u) { return 5 + Math.sqrt(U[u].total) * 1.8; }',
    '  function anchor(u) { var s = U[u].subsystem; return isOpen(s) ? { x: U[u].x, y: U[u].y, r: nodeRadius(u) } : { x: S[s].x, y: S[s].y, r: groupRadius(s) }; }',
    '  // Zugeklappt füllt ein Teilsystem den größten Teil seines Platzes auf der Karte.',
    '  function groupRadius(s) { return Math.max(20, S[s].r * 0.8); }',
    '  function groupFont(s) { return Math.max(12, groupRadius(s) / 5); }',
    '  function draw() {',
    '    var rings = $(''rings''), lg = $(''links''), ng = $(''nodes''), showCyc = $(''cyc'').checked, useImpl = $(''impl'').checked, labels = $(''lbl'').checked;',
    '    var showCmp = C && $(''cmp'').checked;',
    '    var q = $(''q'').value.trim().toLowerCase();',
    '    rings.textContent = ''''; lg.textContent = ''''; ng.textContent = '''';',
    '    // Kanten; zugeklappte Teilsysteme fassen ihre Kanten zu einer zusammen.',
    '    var seen = {};',
    '    links.forEach(function (l) {',
    '      if (!visibleUnit(l.s) || !visibleUnit(l.t) || (!useImpl && l.k === ''m'')) return;',
    '      var a = anchor(l.s), b = anchor(l.t), ss = U[l.s].subsystem, ts = U[l.t].subsystem;',
    '      var key = (isOpen(ss) ? ''u'' + l.s : ''s'' + ss) + ''>'' + (isOpen(ts) ? ''u'' + l.t : ''s'' + ts);',
    '      if (!isOpen(ss) && !isOpen(ts) && ss === ts) return;',
