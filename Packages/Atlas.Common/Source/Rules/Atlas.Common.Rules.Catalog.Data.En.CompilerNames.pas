    'ameters and pointers stay silent. Quick fixes: Dispose(A) becomes A := nil, New(A) becomes SetLength(A, 1).",',
    '      "bad": "Dispose(Werte);",',
    '      "good": "Werte := nil;",',
    '      "compilerCodes": [',
    '        "E2255",',
    '        "E2008",',
    '        "E2256",',
    '        "E2246",',
    '        "E2307",',
    '        "E2308"',
    '      ],',
    '      "level": "B"',
    '    },',
    '{',
    '      "id": "local-routine-as-callback",',
    '      "name": "Local routine as procedure variable",',
