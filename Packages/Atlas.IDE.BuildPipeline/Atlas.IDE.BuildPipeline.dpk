package Atlas.IDE.BuildPipeline;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Build-Pipeline'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Build-Pipeline (#1456, ADR 0017): Build-Aufträge über IAtlasBuildJobs für andere Module.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.BuildPipeline.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package und
// Atlas.IDE.Contracts, kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base,
  Atlas.IDE.Contracts;

contains
  Atlas.UI.BuildPipeline.Strings in 'Source\UI\BuildPipeline\Atlas.UI.BuildPipeline.Strings.pas',
  Atlas.Core.BuildPipeline.Inbox in 'Source\Core\BuildPipeline\Atlas.Core.BuildPipeline.Inbox.pas',
  Atlas.IDE.BuildPipeline.Runner in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.Runner.pas',
  Atlas.IDE.BuildPipeline.Inbox in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.Inbox.pas',
  Atlas.Core.BuildPipeline.ReleaseGuard in 'Source\Core\BuildPipeline\Atlas.Core.BuildPipeline.ReleaseGuard.pas',
  Atlas.IDE.BuildPipeline.ReleaseGuard in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.ReleaseGuard.pas',
  Atlas.Core.BuildPipeline.Gate in 'Source\Core\BuildPipeline\Atlas.Core.BuildPipeline.Gate.pas',
  Atlas.IDE.BuildPipeline.Gate in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.Gate.pas',
  Atlas.IDE.BuildPipeline.Summary in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.Summary.pas',
  Atlas.IDE.BuildPipeline.Composition in 'Source\IDE\BuildPipeline\Atlas.IDE.BuildPipeline.Composition.pas';

end.
