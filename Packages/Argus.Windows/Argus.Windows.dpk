package Argus.Windows;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Argus Windows (frei von VCL)'}
{$RUNONLY}
{$IMPLICITBUILD ON}

// Platform-Package für Windows-spezifische Funktionen, ohne Abhängigkeit zur VCL.
// Erlaubt sind RTL, Winapi.* und System.Win.* sowie Argus.Common.
// Geprüft durch Tools\Check-PackageDependencies.ps1.

requires
  rtl,
  Argus.Common;

contains
  Argus.Windows.Diagnostics.DebugOutput in 'Source\Diagnostics\Argus.Windows.Diagnostics.DebugOutput.pas',
  Argus.Windows.Diagnostics.Adapters.DebugOutputSink in 'Source\Diagnostics\Argus.Windows.Diagnostics.Adapters.DebugOutputSink.pas',
  Argus.Windows.Diagnostics.StackTrace in 'Source\Diagnostics\Argus.Windows.Diagnostics.StackTrace.pas',
  Argus.Windows.Projects.DelphiInstallation in 'Source\Projects\Argus.Windows.Projects.DelphiInstallation.pas',
  Argus.Windows.Compiler.Adapters.ProcessRunner in 'Source\Compiler\Argus.Windows.Compiler.Adapters.ProcessRunner.pas',
  Argus.Windows.Documents.PathCanonicalizer in 'Source\Documents\Argus.Windows.Documents.PathCanonicalizer.pas',
  Argus.Windows.Console.StdStreams in 'Source\Console\Argus.Windows.Console.StdStreams.pas',
  Argus.Windows.Editing.SystemColors in 'Source\Editing\Argus.Windows.Editing.SystemColors.pas';

end.
