package Atlas.IDE.Tests;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Tests'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Tests (#1456): Testläufe, betroffene Tests, Test-Linsen und Test am Cursor debuggen.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.Tests.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package
// (mit den Verträgen zwischen Modulen), kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base;

contains
  Atlas.UI.Tests.Strings in 'Source\UI\Tests\Atlas.UI.Tests.Strings.pas',
  Atlas.UI.Tests.Compare in 'Source\UI\Tests\Atlas.UI.Tests.Compare.pas',
  Atlas.UI.Tests.Slowest in 'Source\UI\Tests\Atlas.UI.Tests.Slowest.pas',
  Atlas.Core.Tests.Run in 'Source\Core\Tests\Atlas.Core.Tests.Run.pas',
  Atlas.Core.Tests.Stale in 'Source\Core\Tests\Atlas.Core.Tests.Stale.pas',
  Atlas.Core.Tests.OnSave in 'Source\Core\Tests\Atlas.Core.Tests.OnSave.pas',
  Atlas.Core.Tests.Leaks in 'Source\Core\Tests\Atlas.Core.Tests.Leaks.pas',
  Atlas.Core.Tests.AssertLine in 'Source\Core\Tests\Atlas.Core.Tests.AssertLine.pas',
  Atlas.Core.Tests.Compare in 'Source\Core\Tests\Atlas.Core.Tests.Compare.pas',
  Atlas.Core.Tests.Durations in 'Source\Core\Tests\Atlas.Core.Tests.Durations.pas',
  Atlas.Core.Tests.AffectedHook in 'Source\Core\Tests\Atlas.Core.Tests.AffectedHook.pas',
  Atlas.Core.Tests.Debug in 'Source\Core\Tests\Atlas.Core.Tests.Debug.pas',
  Atlas.Core.Tests.ProjectChoice in 'Source\Core\Tests\Atlas.Core.Tests.ProjectChoice.pas',
  Atlas.Core.Tests.UnitMatch in 'Source\Core\Tests\Atlas.Core.Tests.UnitMatch.pas',
  Atlas.IDE.Tests.Projects in 'Source\IDE\Tests\Atlas.IDE.Tests.Projects.pas',
  Atlas.IDE.Tests.Runner in 'Source\IDE\Tests\Atlas.IDE.Tests.Runner.pas',
  Atlas.IDE.Tests.Composition in 'Source\IDE\Tests\Atlas.IDE.Tests.Composition.pas',
  Atlas.IDE.Tests.Composition.Hooks in 'Source\IDE\Tests\Atlas.IDE.Tests.Composition.Hooks.pas',
  Atlas.IDE.Tests.Affected in 'Source\IDE\Tests\Atlas.IDE.Tests.Affected.pas',
  Atlas.IDE.Tests.UnitCommands in 'Source\IDE\Tests\Atlas.IDE.Tests.UnitCommands.pas',
  Atlas.IDE.Tests.Debug in 'Source\IDE\Tests\Atlas.IDE.Tests.Debug.pas',
  Atlas.IDE.Tests.Lens in 'Source\IDE\Tests\Atlas.IDE.Tests.Lens.pas',
  Atlas.IDE.Tests.Stale in 'Source\IDE\Tests\Atlas.IDE.Tests.Stale.pas',
  Atlas.IDE.Tests.Output in 'Source\IDE\Tests\Atlas.IDE.Tests.Output.pas',
  Atlas.IDE.Tests.OnSave in 'Source\IDE\Tests\Atlas.IDE.Tests.OnSave.pas',
  Atlas.IDE.Tests.Compare in 'Source\IDE\Tests\Atlas.IDE.Tests.Compare.pas',
  Atlas.IDE.Tests.Slowest in 'Source\IDE\Tests\Atlas.IDE.Tests.Slowest.pas',
  Atlas.UI.Tests.SettingsSection in 'Source\UI\Tests\Atlas.UI.Tests.SettingsSection.pas';

end.
