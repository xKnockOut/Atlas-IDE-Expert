class function TAtlasBreakpointsStrings.Text(AId: TAtlasBreakpointsTextId): string;
begin
  Result := cTexts[TAtlasStrings.Language, AId];
end;

class function TAtlasBreakpointsStrings.Fmt(AId: TAtlasBreakpointsTextId; const AArgs: array of const): string;
begin
  Result := Format(cTexts[TAtlasStrings.Language, AId], AArgs);
end;

end.
