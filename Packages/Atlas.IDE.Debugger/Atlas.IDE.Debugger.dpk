  Atlas.Core.Debug.InlineValues in 'Source\Core\Debug\Atlas.Core.Debug.InlineValues.pas',
  Atlas.IDE.Debug.InlineValues in 'Source\IDE\Debug\Atlas.IDE.Debug.InlineValues.pas',
  Atlas.Core.Debug.Unavailable in 'Source\Core\Debug\Atlas.Core.Debug.Unavailable.pas',
  Atlas.IDE.Debug.Unavailable in 'Source\IDE\Debug\Atlas.IDE.Debug.Unavailable.pas',
  Atlas.IDE.Debug.UnavailableFixes in 'Source\IDE\Debug\Atlas.IDE.Debug.UnavailableFixes.pas',
  Atlas.Core.Debug.DialogCompletion in 'Source\Core\Debug\Atlas.Core.Debug.DialogCompletion.pas',
  Atlas.IDE.Debug.DialogCompletion in 'Source\IDE\Debug\Atlas.IDE.Debug.DialogCompletion.pas',
  Atlas.Core.Debug.Evaluate in 'Source\Core\Debug\Atlas.Core.Debug.Evaluate.pas',
  Atlas.UI.Debug.EvaluateTree in 'Source\UI\Debug\Atlas.UI.Debug.EvaluateTree.pas',
  Atlas.UI.Debug.EvaluateFrame in 'Source\UI\Debug\Atlas.UI.Debug.EvaluateFrame.pas' {AtlasDebugEvaluateFrame: TFrame},
  Atlas.IDE.Debug.EvaluateWindow in 'Source\IDE\Debug\Atlas.IDE.Debug.EvaluateWindow.pas',
  Atlas.IDE.Debug.Evaluate in 'Source\IDE\Debug\Atlas.IDE.Debug.Evaluate.pas',
  Atlas.IDE.Debug.EvaluateHook in 'Source\IDE\Debug\Atlas.IDE.Debug.EvaluateHook.pas',
  Atlas.IDE.Debug.EvaluateStore in 'Source\IDE\Debug\Atlas.IDE.Debug.EvaluateStore.pas',
  Atlas.Core.Debug.AccessViolation in 'Source\Core\Debug\Atlas.Core.Debug.AccessViolation.pas',
  Atlas.UI.Debug.AccessViolation in 'Source\UI\Debug\Atlas.UI.Debug.AccessViolation.pas',
  Atlas.UI.Debug.Deadlocks in 'Source\UI\Debug\Atlas.UI.Debug.Deadlocks.pas',
  Atlas.UI.Debug.ParallelStacks in 'Source\UI\Debug\Atlas.UI.Debug.ParallelStacks.pas',
