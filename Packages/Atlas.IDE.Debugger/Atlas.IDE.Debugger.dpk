  Atlas.UI.Debug.StepFilterFrame in 'Source\UI\Debug\Atlas.UI.Debug.StepFilterFrame.pas' {AtlasDebugStepFilterFrame: TFrame},
  Atlas.IDE.Debug.StepFilterWindow in 'Source\IDE\Debug\Atlas.IDE.Debug.StepFilterWindow.pas',
  Atlas.IDE.Debug.StepFilter in 'Source\IDE\Debug\Atlas.IDE.Debug.StepFilter.pas',
  Atlas.Core.Debug.BreakpointCheck in 'Source\Core\Debug\Atlas.Core.Debug.BreakpointCheck.pas',
  Atlas.UI.Debug.BreakpointCheck in 'Source\UI\Debug\Atlas.UI.Debug.BreakpointCheck.pas',
  Atlas.IDE.Debug.BreakpointCheck in 'Source\IDE\Debug\Atlas.IDE.Debug.BreakpointCheck.pas',
  Atlas.Core.Debug.BreakpointSets in 'Source\Core\Debug\Atlas.Core.Debug.BreakpointSets.pas',
  Atlas.UI.Debug.BreakpointSets in 'Source\UI\Debug\Atlas.UI.Debug.BreakpointSets.pas',
  Atlas.IDE.Debug.BreakpointSets in 'Source\IDE\Debug\Atlas.IDE.Debug.BreakpointSets.pas',
  Atlas.IDE.Debug.Report in 'Source\IDE\Debug\Atlas.IDE.Debug.Report.pas',
  Atlas.IDE.Debug.Composition.Values in 'Source\IDE\Debug\Atlas.IDE.Debug.Composition.Values.pas',
  Atlas.IDE.Debug.Composition.Breakpoints in 'Source\IDE\Debug\Atlas.IDE.Debug.Composition.Breakpoints.pas',
  Atlas.IDE.Debug.Composition.Session in 'Source\IDE\Debug\Atlas.IDE.Debug.Composition.Session.pas',
  Atlas.IDE.Debug.Composition in 'Source\IDE\Debug\Atlas.IDE.Debug.Composition.pas',
  Atlas.UI.Debug.SettingsSection in 'Source\UI\Debug\Atlas.UI.Debug.SettingsSection.pas',
  Atlas.Core.Debug.EventLog in 'Source\Core\Debug\Atlas.Core.Debug.EventLog.pas',
  Atlas.UI.Debug.EventLogFrame in 'Source\UI\Debug\Atlas.UI.Debug.EventLogFrame.pas' {AtlasDebugEventLogFrame: TFrame},
  Atlas.IDE.Debug.EventLogMirror in 'Source\IDE\Debug\Atlas.IDE.Debug.EventLogMirror.pas',
  Atlas.IDE.Debug.EventLogWindow in 'Source\IDE\Debug\Atlas.IDE.Debug.EventLogWindow.pas',
