package Atlas.IDE.Debugger;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Debugger'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Debugger (#1456): Exception-Verlauf und -Leiste, Werte im Editor, nur eigener Code,
// Visualisierer, eigene Wertdarstellungen und Auswerten. Meldet sich in der Unit-Initialisierung von
// Atlas.IDE.Debug.Composition über die Registry von Atlas.IDE.Base an und lässt sich ohne Neustart
// der IDE laden und entladen (Regeln 1 bis 4). Requiret nur das Kern-Package
// (mit den Verträgen zwischen Modulen), kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base;

