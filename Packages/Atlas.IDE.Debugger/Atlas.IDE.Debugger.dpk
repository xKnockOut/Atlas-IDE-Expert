package Atlas.IDE.Debugger;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Debugger'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Debugger (#1456): Exception-Verlauf und -Leiste, Werte im Editor, nur eigener Code,
// Visualisierer, eigene Wertdarstellungen und Auswerten. Meldet sich in der Unit-Initialisierung von
// Atlas.IDE.Debug.Composition über die Registry von Atlas.IDE.Base an und lässt sich ohne Neustart
// der IDE laden und entladen (Regeln 1 bis 4). Requiret nur das Kern-Package
// (mit den Verträgen zwischen Modulen), kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base;

contains
  Atlas.Core.Debug.Visualizers in 'Source\Core\Debug\Atlas.Core.Debug.Visualizers.pas',
  Atlas.Core.Debug.DisplayRules in 'Source\Core\Debug\Atlas.Core.Debug.DisplayRules.pas',
  Atlas.Core.Debug.StepInto in 'Source\Core\Debug\Atlas.Core.Debug.StepInto.pas',
  Atlas.Core.Debug.EventBreak in 'Source\Core\Debug\Atlas.Core.Debug.EventBreak.pas',
  Atlas.Core.Debug.InstanceBreakpoint in 'Source\Core\Debug\Atlas.Core.Debug.InstanceBreakpoint.pas',
  Atlas.UI.Debug.Strings in 'Source\UI\Debug\Atlas.UI.Debug.Strings.pas',
  Atlas.IDE.Debug.Evaluator in 'Source\IDE\Debug\Atlas.IDE.Debug.Evaluator.pas',
  Atlas.IDE.Debug.Visualizers in 'Source\IDE\Debug\Atlas.IDE.Debug.Visualizers.pas',
  Atlas.IDE.Debug.DisplayRules in 'Source\IDE\Debug\Atlas.IDE.Debug.DisplayRules.pas',
  Atlas.IDE.Debug.StepInto in 'Source\IDE\Debug\Atlas.IDE.Debug.StepInto.pas',
  Atlas.IDE.Debug.Breakpoints in 'Source\IDE\Debug\Atlas.IDE.Debug.Breakpoints.pas',
  Atlas.IDE.Debug.EventBreak in 'Source\IDE\Debug\Atlas.IDE.Debug.EventBreak.pas',
  Atlas.IDE.Debug.Modules in 'Source\IDE\Debug\Atlas.IDE.Debug.Modules.pas',
  Atlas.IDE.Debug.Deadlocks in 'Source\IDE\Debug\Atlas.IDE.Debug.Deadlocks.pas',
  Atlas.IDE.Debug.Threads in 'Source\IDE\Debug\Atlas.IDE.Debug.Threads.pas',
  Atlas.IDE.Debug.ParallelStacks in 'Source\IDE\Debug\Atlas.IDE.Debug.ParallelStacks.pas',
  Atlas.IDE.Debug.ThreadFreeze in 'Source\IDE\Debug\Atlas.IDE.Debug.ThreadFreeze.pas',
  Atlas.IDE.Debug.ThreadsInSource in 'Source\IDE\Debug\Atlas.IDE.Debug.ThreadsInSource.pas',
  Atlas.IDE.Debug.ThreadsGutter in 'Source\IDE\Debug\Atlas.IDE.Debug.ThreadsGutter.pas',
  Atlas.IDE.Debug.ParallelStacksWindow in 'Source\IDE\Debug\Atlas.IDE.Debug.ParallelStacksWindow.pas',
  Atlas.UI.Debug.Viewer in 'Source\UI\Debug\Atlas.UI.Debug.Viewer.pas',
  Atlas.UI.Debug.StepInto in 'Source\UI\Debug\Atlas.UI.Debug.StepInto.pas',
  Atlas.UI.Debug.InlineValuePainter in 'Source\UI\Debug\Atlas.UI.Debug.InlineValuePainter.pas',
  Atlas.UI.Debug.EventBreak in 'Source\UI\Debug\Atlas.UI.Debug.EventBreak.pas',
  Atlas.Core.Debug.Exceptions in 'Source\Core\Debug\Atlas.Core.Debug.Exceptions.pas',
  Atlas.Core.Debug.Note in 'Source\Core\Debug\Atlas.Core.Debug.Note.pas',
  Atlas.Core.Debug.CallStack in 'Source\Core\Debug\Atlas.Core.Debug.CallStack.pas',
  Atlas.Core.Debug.IgnoreList in 'Source\Core\Debug\Atlas.Core.Debug.IgnoreList.pas',
  Atlas.Core.Debug.ExceptionDialog in 'Source\Core\Debug\Atlas.Core.Debug.ExceptionDialog.pas',
  Atlas.Core.Debug.Modules in 'Source\Core\Debug\Atlas.Core.Debug.Modules.pas',
  Atlas.Core.Debug.Threads in 'Source\Core\Debug\Atlas.Core.Debug.Threads.pas',
  Atlas.Core.Debug.Deadlocks in 'Source\Core\Debug\Atlas.Core.Debug.Deadlocks.pas',
  Atlas.Core.Debug.ParallelStacks in 'Source\Core\Debug\Atlas.Core.Debug.ParallelStacks.pas',
  Atlas.Core.Debug.ThreadMarks in 'Source\Core\Debug\Atlas.Core.Debug.ThreadMarks.pas',
  Atlas.UI.Debug.ExceptionStack in 'Source\UI\Debug\Atlas.UI.Debug.ExceptionStack.pas',
