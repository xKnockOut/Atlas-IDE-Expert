package Atlas.IDE.Build;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Atlas IDE Expert – Build-Werkzeuge'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Modul Build-Werkzeuge (#1456): Aufgaben vor und nach dem Build,
// Compilerschalter, Startprofile, Build öffnen.
// Meldet sich in der Unit-Initialisierung von Atlas.IDE.BuildTools.Composition über die Registry
// des Kern-Packages Atlas.IDE.Base an und lässt sich ohne Neustart der IDE laden und entladen
// (Regeln 1 bis 4). Requiret nur das Kern-Package
// (mit den Verträgen zwischen Modulen), kein anderes Modul (Regel 9).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  Atlas.IDE.Base;

contains
  Atlas.UI.Build.Strings in 'Source\UI\Build\Atlas.UI.Build.Strings.pas',
  Atlas.Core.Tasks.Definitions in 'Source\Core\Tasks\Atlas.Core.Tasks.Definitions.pas',
  Atlas.Core.Tasks.Matchers in 'Source\Core\Tasks\Atlas.Core.Tasks.Matchers.pas',
  Atlas.Core.Tasks.Runs in 'Source\Core\Tasks\Atlas.Core.Tasks.Runs.pas',
  Atlas.Core.Tasks.Commands in 'Source\Core\Tasks\Atlas.Core.Tasks.Commands.pas',
  Atlas.Core.Tasks.Adapters.Process in 'Source\Core\Tasks\Atlas.Core.Tasks.Adapters.Process.pas',
  Atlas.Core.Tasks.Reports in 'Source\Core\Tasks\Atlas.Core.Tasks.Reports.pas',
  Atlas.Core.Tasks.PreBuild in 'Source\Core\Tasks\Atlas.Core.Tasks.PreBuild.pas',
  Atlas.Core.Tasks.OutputGroup in 'Source\Core\Tasks\Atlas.Core.Tasks.OutputGroup.pas',
  Atlas.UI.Tasks.Texts in 'Source\UI\Tasks\Atlas.UI.Tasks.Texts.pas',
  Atlas.IDE.Tasks.Output in 'Source\IDE\Tasks\Atlas.IDE.Tasks.Output.pas',
  Atlas.IDE.Tasks.Projects in 'Source\IDE\Tasks\Atlas.IDE.Tasks.Projects.pas',
  Atlas.IDE.Tasks.Shortcuts in 'Source\IDE\Tasks\Atlas.IDE.Tasks.Shortcuts.pas',
  Atlas.IDE.Tasks.Pickers in 'Source\IDE\Tasks\Atlas.IDE.Tasks.Pickers.pas',
  Atlas.IDE.Tasks.Runner in 'Source\IDE\Tasks\Atlas.IDE.Tasks.Runner.pas',
  Atlas.Core.Build.OpenBuild in 'Source\Core\Build\Atlas.Core.Build.OpenBuild.pas',
  Atlas.IDE.Build.OpenBuild in 'Source\IDE\Build\Atlas.IDE.Build.OpenBuild.pas',
  Atlas.IDE.BuildTools.Composition in 'Source\IDE\BuildTools\Atlas.IDE.BuildTools.Composition.pas',
  Atlas.IDE.StartProfiles.Service in 'Source\IDE\StartProfiles\Atlas.IDE.StartProfiles.Service.pas',
  Atlas.Core.Build.CompilerSwitches in 'Source\Core\Build\Atlas.Core.Build.CompilerSwitches.pas',
  Atlas.UI.Build.SwitchesFrame in 'Source\UI\Build\Atlas.UI.Build.SwitchesFrame.pas' {AtlasBuildSwitchesFrame: TFrame},
  Atlas.IDE.Build.SwitchesWindow in 'Source\IDE\Build\Atlas.IDE.Build.SwitchesWindow.pas',
  Atlas.IDE.Build.CompilerSwitches in 'Source\IDE\Build\Atlas.IDE.Build.CompilerSwitches.pas',
  Atlas.UI.Build.SettingsSection in 'Source\UI\Build\Atlas.UI.Build.SettingsSection.pas';

end.
