{
  "$schema": "https://raw.githubusercontent.com/xKnockOut/Atlas-IDE-Expert/main/schemas/atlas.schema.json",
  "profile": "strict",
  "minConfidence": "low",
  "testProfile": "standard",
  "exclude": [
    "__history/**",
    "__recovery/**"
  ],
  "rules": {
    "loop-runs-at-most-once": {
      "allowFirstElement": true
    },
    "narrowing-assignment": "off",
    "method-order": "off",
    "ota-entry-without-guard": {
      "guards": [
        "TAtlasGuard.Run(TAtlasFeature.Menu, ",
        "TAtlasGuard.RunProvider",
        "TAtlasGuard.Wrap"
      ]
    },
    "register-does-work": {
      "entries": [
        "Register",
        "RegisterModule",
        "*.RegisterModule"
      ]
    },
    "architecture-role-import": {
      "severity": "warning",
      "exclude": [
        "Tests/**"
      ],
      "prefixes": [
        "Atlas.Text",
        "Atlas.WinBase",
        "Atlas.Common",
        "Atlas.Windows",
        "Atlas.Linux",
        "Atlas.Core",
        "Atlas.UI",
        "Atlas.IDE"
      ],
      "allow": [
        "Atlas.Common.Rules.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Semantics.Contract -> Atlas.Common.Pascal.SyntaxTree",
        "Atlas.Common.Documents.Contract -> Atlas.Text.Lines",
        "Atlas.Core.Lsp.Contract -> Atlas.Text.Json",
        "Atlas.Core.Projects.Contract -> Atlas.Text.Json",
        "Atlas.IDE.CodeInsight.Composition.HostAdapters -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.CodeInsight.Composition.HostAdapters -> Atlas.IDE.Undo.Adapters.*",
        "Atlas.IDE.CodeInsight.Composition.IdeAdapters -> Atlas.IDE.*.Adapters.*",
        "Atlas.IDE.CodeInsight.Composition.UiAdapters -> Atlas.UI.*.Adapters.*",
        "Atlas.IDE.CodeInsight.Composition.ProblemsAdapters -> Atlas.IDE.Problems.Adapters.*",
        "Atlas.IDE.Assistants.Composition.HostAdapters -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.BuildTools.Composition -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.Debug.Composition -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.Tests.Composition -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.Tracker.Composition -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.VersionControl.Composition -> Atlas.Core.*.Providers.*",
        "Atlas.IDE.VersionControl.Composition -> Atlas.Core.VersionControl.Composition"
      ]
    },
    "architecture-contract-content": {
      "severity": "warning",
      "exclude": [
        "Tests/**"
      ],
      "prefixes": [
        "Atlas.Text",
        "Atlas.WinBase",
        "Atlas.Common",
        "Atlas.Windows",
        "Atlas.Linux",
        "Atlas.Core",
        "Atlas.UI",
        "Atlas.IDE"
      ],
      "allow": [
        "Atlas.Common.Dfm.Contract.TDfm*"
      ]
    },
    "forbidden-symbol": {
      "severity": "error",
      "exclude": [
        "Tests/**",
        "Tools/**"
      ],
      "symbols": [
        {
          "name": "System.Write",
          "kind": "routine",
          "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": [
            "ErrOutput",
            "TextFile",
            "Text"
          ]
        },
        {
          "name": "System.Writeln",
          "kind": "routine",
          "message": "stdout gehört dem LSP-Protokoll, Diagnose über ILogger",
          "allowFirstArgument": [
            "ErrOutput",
            "TextFile",
            "Text"
          ]
        },
        {
          "name": "Winapi.Windows.GetStdHandle",
          "message": "stdout-Handle nur über TStdStreams",
          "firstArgument": [
            "STD_OUTPUT_HANDLE"
          ],
          "units": [
            "!Atlas.Windows.Console.StdStreams"
          ]
        },
        {
          "name": "System.Classes.TThread.Queue",
          "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.Queue verwenden",
          "firstArgument": [
            "nil"
          ],
          "units": [
            "Atlas.Core.*",
            "Atlas.UI.*",
            "Atlas.IDE.*"
          ]
        },
        {
          "name": "System.Classes.TThread.ForceQueue",
          "message": "Einreihen ohne Besitzer überlebt das Entladen, TAtlasMainThread.ForceQueue verwenden",
          "firstArgument": [
            "nil"
          ],
          "units": [
            "Atlas.Core.*",
            "Atlas.UI.*",
            "Atlas.IDE.*"
          ]
        },
        {
          "name": "Winapi.Windows.GetTickCount",
          "message": "32-Bit-Zähler läuft nach 49,7 Tagen über, TAtlasTicks bzw. TAtlasDeadline verwenden",
          "units": [
            "!Atlas.Core.Diagnostics.UserIdle"
          ]
        },
        {
          "name": "System.Classes.TThread.GetTickCount",
          "message": "32-Bit-Zähler läuft nach 49,7 Tagen über, TAtlasTicks bzw. TAtlasDeadline verwenden"
        },
        {
          "name": "Winapi.Windows.CreateProcess",
          "message": "Kindprozesse über TAtlasProcessLauncher.Launch starten: vererbt nur die Standard-Handles (Handle-Liste)",
          "units": [
            "!Atlas.WinBase.Process"
          ]
        }
      ]
    },
    "catch-all-without-raise": {
      "severity": "warning",
      "exclude": [
        "Tests/**",
        "Tools/**"
      ],
      "allowExceptionUse": true,
      "reporters": [
        "TAtlasGuard.*",
        "TReporting.Failed",
        "TAtlasDataFile.ReportNotWritten",
        "TAtlasIdeHost.Message",
        "TAtlasIdeHost.Warning",
        "TAtlasIdeHost.Log",
        "Say",
        "*.Say",
        "*Logger.Error",
        "*Logger.Warning",
        "TLinterOutput.Error"
      ]
    }
  }
}
