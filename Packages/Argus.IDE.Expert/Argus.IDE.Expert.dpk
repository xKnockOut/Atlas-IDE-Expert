package Argus.IDE.Expert;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Argus IDE Expert (Code Insight-Manager)'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

// Design-Time-Package für RAD Studio (ADR 0006): meldet Argus als
// Code Insight-Manager für Delphi an und spricht über eine eigene LSP-Sitzung
// mit dem Server. Nur Win32, weil die IDE (bds.exe) 32-Bit ist.
// Bewusst ohne Argus.Common/Argus.Windows: ein einzelnes Package, das die IDE
// ohne weitere BPLs laden kann.

requires
  rtl,
  vcl,
  designide;

contains
  Argus.Core.Lsp.Client in 'Source\Core\Lsp\Argus.Core.Lsp.Client.pas',
  Argus.Core.Lsp.Session in 'Source\Core\Lsp\Argus.Core.Lsp.Session.pas',
  Argus.Core.Lsp.Adapters.ServerProcess in 'Source\Core\Lsp\Argus.Core.Lsp.Adapters.ServerProcess.pas',
  Argus.Core.Completion.Contract in 'Source\Core\Completion\Argus.Core.Completion.Contract.pas',
  Argus.Core.Completion.Internals.Async in 'Source\Core\Completion\Internals\Argus.Core.Completion.Internals.Async.pas',
  Argus.Core.Completion.Composite in 'Source\Core\Completion\Argus.Core.Completion.Composite.pas',
  Argus.Core.Completion.Providers.Fixed in 'Source\Core\Completion\Providers\Argus.Core.Completion.Providers.Fixed.pas',
  Argus.Core.Completion.Providers.Server in 'Source\Core\Completion\Providers\Argus.Core.Completion.Providers.Server.pas',
  Argus.Core.Completion.Matching in 'Source\Core\Completion\Argus.Core.Completion.Matching.pas',
  Argus.Core.Completion.Controller in 'Source\Core\Completion\Argus.Core.Completion.Controller.pas',
  Argus.Core.Signature.Contract in 'Source\Core\Signature\Argus.Core.Signature.Contract.pas',
  Argus.Core.Hover.Contract in 'Source\Core\Hover\Argus.Core.Hover.Contract.pas',
  Argus.Core.Hover.History in 'Source\Core\Hover\Argus.Core.Hover.History.pas',
  Argus.Core.Signature.CallScanner in 'Source\Core\Signature\Argus.Core.Signature.CallScanner.pas',
  Argus.Core.Signature.Controller in 'Source\Core\Signature\Argus.Core.Signature.Controller.pas',
  Argus.Core.Signature.Providers.Server in 'Source\Core\Signature\Argus.Core.Signature.Providers.Server.pas',
  Argus.UI.Signature.Hint in 'Source\UI\Signature\Argus.UI.Signature.Hint.pas',
  Argus.UI.Popup.Window in 'Source\UI\Popup\Argus.UI.Popup.Window.pas',
  Argus.UI.Completion.Popup in 'Source\UI\Completion\Argus.UI.Completion.Popup.pas',
  Argus.UI.Completion.Details in 'Source\UI\Completion\Argus.UI.Completion.Details.pas',
  Argus.Core.Style.Color in 'Source\Core\Style\Argus.Core.Style.Color.pas',
  Argus.Core.Style.Palette in 'Source\Core\Style\Argus.Core.Style.Palette.pas',
  Argus.Core.Style.Syntax in 'Source\Core\Style\Argus.Core.Style.Syntax.pas',
  Argus.Core.Style.Scaling in 'Source\Core\Style\Argus.Core.Style.Scaling.pas',
  Argus.Core.Completion.Presentation in 'Source\Core\Completion\Argus.Core.Completion.Presentation.pas',
  Argus.Core.Completion.Word in 'Source\Core\Completion\Argus.Core.Completion.Word.pas',
  Argus.UI.Popup.Styled in 'Source\UI\Popup\Argus.UI.Popup.Styled.pas',
  Argus.UI.Popup.Tip in 'Source\UI\Popup\Argus.UI.Popup.Tip.pas',
  Argus.IDE.Editor.Style in 'Source\IDE\Editor\Argus.IDE.Editor.Style.pas',
  Argus.IDE.Editor.Buffer in 'Source\IDE\Editor\Argus.IDE.Editor.Buffer.pas',
  Argus.IDE.Editor.KeyHook in 'Source\IDE\Editor\Argus.IDE.Editor.KeyHook.pas',
  Argus.IDE.Signature.Editor in 'Source\IDE\Signature\Argus.IDE.Signature.Editor.pas',
  Argus.IDE.Completion.Editor in 'Source\IDE\Completion\Argus.IDE.Completion.Editor.pas',
  Argus.IDE.CodeInsight.Manager in 'Source\IDE\CodeInsight\Argus.IDE.CodeInsight.Manager.pas',
  Argus.IDE.CodeInsight.Composition in 'Source\IDE\CodeInsight\Argus.IDE.CodeInsight.Composition.pas',
  Argus.Core.Settings.Plugin in 'Source\Core\Settings\Argus.Core.Settings.Plugin.pas',
  Argus.UI.Settings.Page in 'Source\UI\Settings\Argus.UI.Settings.Page.pas' {ArgusSettingsPage: TFrame},
  Argus.IDE.Settings.Store in 'Source\IDE\Settings\Argus.IDE.Settings.Store.pas',
  Argus.IDE.Settings.Options in 'Source\IDE\Settings\Argus.IDE.Settings.Options.pas',
  Argus.Core.Completion.Ranking in 'Source\Core\Completion\Argus.Core.Completion.Ranking.pas',
  Argus.Core.Completion.Usage in 'Source\Core\Completion\Argus.Core.Completion.Usage.pas',
  Argus.IDE.Completion.History in 'Source\IDE\Completion\Argus.IDE.Completion.History.pas',
  Argus.UI.Strings in 'Source\UI\Argus.UI.Strings.pas',
  Argus.Core.Completion.Providers.XmlDoc in 'Source\Core\Completion\Providers\Argus.Core.Completion.Providers.XmlDoc.pas',
  Argus.Core.Completion.Parentheses in 'Source\Core\Completion\Argus.Core.Completion.Parentheses.pas',
  Argus.UI.Hover.Tip in 'Source\UI\Hover\Argus.UI.Hover.Tip.pas',
  Argus.IDE.Hover.Editor in 'Source\IDE\Hover\Argus.IDE.Hover.Editor.pas',
  Argus.Core.Completion.Preview in 'Source\Core\Completion\Argus.Core.Completion.Preview.pas',
  Argus.IDE.Completion.Preview in 'Source\IDE\Completion\Argus.IDE.Completion.Preview.pas',
  Argus.Core.Build.Events in 'Source\Core\Build\Argus.Core.Build.Events.pas',
  Argus.IDE.Build.Notifier in 'Source\IDE\Build\Argus.IDE.Build.Notifier.pas',
  Argus.Core.Diagnostics.Hangs in 'Source\Core\Diagnostics\Argus.Core.Diagnostics.Hangs.pas',
  Argus.IDE.Diagnostics.Watchdog in 'Source\IDE\Diagnostics\Argus.IDE.Diagnostics.Watchdog.pas',
  Argus.Core.Files.ExternalChanges in 'Source\Core\Files\Argus.Core.Files.ExternalChanges.pas',
  Argus.IDE.Files.Reloader in 'Source\IDE\Files\Argus.IDE.Files.Reloader.pas',
  Argus.Core.Commands.Palette in 'Source\Core\Commands\Argus.Core.Commands.Palette.pas',
  Argus.UI.Commands.Palette in 'Source\UI\Commands\Argus.UI.Commands.Palette.pas',
  Argus.IDE.Commands.Palette in 'Source\IDE\Commands\Argus.IDE.Commands.Palette.pas',
  Argus.Core.Editor.Pairs in 'Source\Core\Editor\Argus.Core.Editor.Pairs.pas',
  Argus.IDE.Editor.Pairs in 'Source\IDE\Editor\Argus.IDE.Editor.Pairs.pas',
  Argus.IDE.Build.MessageView in 'Source\IDE\Build\Argus.IDE.Build.MessageView.pas',
  Argus.Core.Build.Messages in 'Source\Core\Build\Argus.Core.Build.Messages.pas',
  Argus.Core.Build.CheckOnSave in 'Source\Core\Build\Argus.Core.Build.CheckOnSave.pas',
  Argus.IDE.Build.CheckOnSave in 'Source\IDE\Build\Argus.IDE.Build.CheckOnSave.pas';

end.
