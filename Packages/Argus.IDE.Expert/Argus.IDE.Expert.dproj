<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6E1B3C52-7F0A-4C1D-9B8E-2A5D4F7C9E31}</ProjectGuid>
        <MainSource>Argus.IDE.Expert.dpk</MainSource>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Package</AppType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <ProjectName Condition="'$(ProjectName)'==''">Argus.IDE.Expert</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64x' and '$(Base)'=='true') or '$(Base_Win64x)'!=''">
        <Base_Win64x>true</Base_Win64x>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>Argus_IDE_Expert</SanitizedProjectName>
        <GenPackage>true</GenPackage>
        <GenDll>true</GenDll>
        <DesignOnlyPackage>true</DesignOnlyPackage>
        <DCC_Description>Argus IDE Expert (Code Insight-Manager)</DCC_Description>
        <DCC_Namespace>System;Winapi;System.Win;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
        <DCC_DcuOutput>..\..\Output\$(Platform)\$(Config)\Dcu\Argus.IDE.Expert</DCC_DcuOutput>
        <DCC_DcpOutput>..\..\Output\$(Platform)\$(Config)\Dcp</DCC_DcpOutput>
        <DCC_BplOutput>..\..\Output\$(Platform)\$(Config)\Bpl</DCC_BplOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64x)'!=''">
        <DCC_Namespace>Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=;FileDescription=$(MSBuildProjectName);FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.embarcadero.$(MSBuildProjectName);ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <BCC_EnableBatchCompilation>true</BCC_EnableBatchCompilation>
        <DCC_UsePackage>vcl;rtl;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>false</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="designide.dcp"/>
        <DCCReference Include="Source\Core\Lsp\Argus.Core.Lsp.Client.pas"/>
        <DCCReference Include="Source\Core\Lsp\Argus.Core.Lsp.Session.pas"/>
        <DCCReference Include="Source\Core\Lsp\Argus.Core.Lsp.Adapters.ServerProcess.pas"/>
        <DCCReference Include="Source\Core\Completion\Argus.Core.Completion.Contract.pas"/>
        <DCCReference Include="Source\Core\Completion\Internals\Argus.Core.Completion.Internals.Async.pas"/>
        <DCCReference Include="Source\Core\Completion\Argus.Core.Completion.Composite.pas"/>
        <DCCReference Include="Source\Core\Completion\Providers\Argus.Core.Completion.Providers.Fixed.pas"/>
        <DCCReference Include="Source\Core\Completion\Providers\Argus.Core.Completion.Providers.Server.pas"/>
        <DCCReference Include="Source\Core\Completion\Argus.Core.Completion.Matching.pas"/>
        <DCCReference Include="Source\Core\Completion\Argus.Core.Completion.Controller.pas"/>
        <DCCReference Include="Source\Core\Signature\Argus.Core.Signature.Contract.pas"/>
        <DCCReference Include="Source\Core\Signature\Argus.Core.Signature.CallScanner.pas"/>
        <DCCReference Include="Source\Core\Signature\Argus.Core.Signature.Controller.pas"/>
        <DCCReference Include="Source\Core\Signature\Argus.Core.Signature.Providers.Server.pas"/>
        <DCCReference Include="Source\UI\Signature\Argus.UI.Signature.Hint.pas"/>
        <DCCReference Include="Source\UI\Popup\Argus.UI.Popup.Window.pas"/>
        <DCCReference Include="Source\UI\Completion\Argus.UI.Completion.Popup.pas"/>
        <DCCReference Include="Source\UI\Completion\Argus.UI.Completion.Details.pas"/>
        <DCCReference Include="Source\IDE\Editor\Argus.IDE.Editor.Buffer.pas"/>
        <DCCReference Include="Source\IDE\Editor\Argus.IDE.Editor.KeyHook.pas"/>
        <DCCReference Include="Source\IDE\Signature\Argus.IDE.Signature.Editor.pas"/>
        <DCCReference Include="Source\IDE\Completion\Argus.IDE.Completion.Editor.pas"/>
        <DCCReference Include="Source\IDE\CodeInsight\Argus.IDE.CodeInsight.Manager.pas"/>
        <DCCReference Include="Source\IDE\CodeInsight\Argus.IDE.CodeInsight.Composition.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Argus.IDE.Expert.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
                <Platform value="Win64x">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
